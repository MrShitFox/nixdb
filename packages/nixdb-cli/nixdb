set -Eeuo pipefail

readonly OPERATOR_CONFIG="${NIXDB_OPERATOR_CONFIG:-/etc/nixdb/operator.json}"

operator_value() {
  local key=$1 fallback=$2
  if [[ -r "$OPERATOR_CONFIG" ]]; then
    jq -r --arg key "$key" --arg fallback "$fallback" '.[$key] // $fallback' "$OPERATOR_CONFIG"
  else
    printf '%s\n' "$fallback"
  fi
}

readonly REPO="${NIXDB_CONFIG_ROOT:-$(operator_value configRoot /etc/nixos)}"
readonly HOST="${NIXDB_HOST:-$(operator_value flakeHost "$(hostname)")}"
readonly INVENTORY="${NIXDB_INVENTORY:-$(operator_value inventoryPath "$REPO/databases.nix")}"
readonly INPUT_NAME="${NIXDB_INPUT_NAME:-$(operator_value inputName nixdb)}"
readonly INPUT_URL="${NIXDB_INPUT_URL:-$(operator_value inputUrl github:MrShitFox/nixdb)}"
readonly RELEASE_REPOSITORY="${NIXDB_RELEASE_REPOSITORY:-$(operator_value releaseRepository https://github.com/MrShitFox/nixdb.git)}"
INSTALLED_VERSION="$(operator_value frameworkVersion unknown)"
INSTALLED_REVISION="$(operator_value frameworkRevision unknown)"
readonly INSTALLED_VERSION INSTALLED_REVISION
readonly FLAKE="$REPO#nixosConfigurations.$HOST.config.services.nixdb"
readonly STATE_DIR="/var/lib/nixdb"

health_tmp=""
deploy_tmp=""

cleanup() {
  if [[ -n "$health_tmp" && -d "$health_tmp" ]]; then
    rm -rf -- "$health_tmp"
  fi
  if [[ -n "$deploy_tmp" && -d "$deploy_tmp" ]]; then
    rm -rf -- "$deploy_tmp"
  fi
}
trap cleanup EXIT

die() {
  echo "nixdb: $*" >&2
  exit 1
}

need_root() {
  if (( EUID != 0 )); then
    exec sudo --preserve-env=NIXDB_OPERATOR_CONFIG,NIXDB_CONFIG_ROOT,NIXDB_HOST,NIXDB_INVENTORY,NIXDB_INPUT_NAME,NIXDB_INPUT_URL,NIXDB_RELEASE_REPOSITORY -- "$0" "$@"
  fi
}

require_repo() {
  [[ -d "$REPO/.git" ]] || die "$REPO is not a Git checkout"
  [[ -f "$INVENTORY" ]] || die "inventory not found: $INVENTORY"
}

require_clean() {
  local changes
  changes=$(git -C "$REPO" status --porcelain --untracked-files=all)
  if [[ -n "$changes" ]]; then
    echo "$changes" >&2
    die "$REPO must be clean before deployment"
  fi
}

instances_json() {
  nix eval --json "$FLAKE._internal.instances"
}

engine_json() {
  nix eval --json "$FLAKE.$1.instances"
}

service_names() {
  instances_json | jq -r '.[].serviceName'
}

latest_stable_tag() {
  git ls-remote --refs --tags "$RELEASE_REPOSITORY" 'refs/tags/v*' 2>/dev/null \
    | awk '{ sub("refs/tags/", "", $2); print $2 }' \
    | sort -V \
    | tail -n 1
}

lock_node() {
  jq -r --arg name "$INPUT_NAME" \
    '.nodes.root.inputs[$name] | if type == "array" then .[-1] else . end' \
    "$REPO/flake.lock"
}

locked_input_field() {
  local field=$1 node
  node=$(lock_node)
  jq -r --arg node "$node" --arg field "$field" \
    '.nodes[$node].locked[$field] // .nodes[$node].original[$field] // "unknown"' \
    "$REPO/flake.lock"
}

show_help() {
  cat <<'EOF'
nixdb - operate the nixdb NixOS database stack

Usage:
  nixdb status                  Show host input, runtime, versions, and units
  nixdb health                  Run full storage/resource/authentication checks
  nixdb versions                Compare declared and runtime component versions
  nixdb quotas                  Show XFS project quota reports
  nixdb resources               Show slice and per-instance cgroup resources
  nixdb config                  Show the inventory path and a masked summary
  nixdb logs <instance>         Show recent journal entries for one DB instance
  nixdb restart <instance>      Restart one managed DB and run health checks
  nixdb update                  Update the host's nixdb input to newest stable v*
  nixdb update --main           Explicitly use the public nixdb main branch
  nixdb deploy <tag-or-revision> Pin the host's nixdb input to an exact release/ref
  nixdb rollback                Roll back one NixOS system generation
  nixdb help                    Show this help

Main inventory:
  Set by services.nixdb.operator.inventoryFile in the downstream host.
EOF
}

cmd_status() {
  require_repo
  local head branch latest clean locked_revision locked_ref target_state failed
  head=$(git -C "$REPO" rev-parse HEAD)
  branch=$(git -C "$REPO" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "detached")
  latest=$(latest_stable_tag || true)
  [[ -n "$latest" ]] || latest="none"
  if [[ -z $(git -C "$REPO" status --porcelain --untracked-files=all) ]]; then
    clean="yes"
  else
    clean="NO"
  fi
  locked_revision=$(locked_input_field rev)
  locked_ref=$(locked_input_field ref)
  if [[ "$INSTALLED_REVISION" == "$locked_revision" ]]; then
    target_state="locked input matches active system"
  elif [[ "$INSTALLED_REVISION" == "unknown" ]]; then
    target_state="active system has no framework revision metadata"
  else
    target_state="WARNING: locked input differs from active system"
  fi
  failed=$(systemctl --failed --no-legend --plain | wc -l)

  cat <<EOF
nixdb status
  Host:                 $(hostname)
  Host config root:     $REPO
  Inventory:            $INVENTORY
  Host Git commit:      $head
  Host branch state:    $branch
  nixdb locked ref:     $locked_ref
  nixdb locked revision: $locked_revision
  nixdb installed:      $INSTALLED_VERSION ($INSTALLED_REVISION)
  Latest stable nixdb:  $latest
  Host tree clean:      $clean
  Deployment state:     $target_state
  NixOS:                $(nixos-version)
  databases.target:     $(systemctl is-active databases.target)
  Failed system units:  $failed

Database engines
  MongoDB:              $(mongod --version | awk '/db version/ { sub(/^v/, "", $3); print $3; exit }')
  MySQL:                $(mysql --version | awk '{ for (i=1; i<=NF; i++) if ($i=="Ver") { print $(i+1); exit } }')
  Manticore Search:     $(searchd --version 2>&1 | sed -n 's/^Manticore \([^ ]*\).*/\1/p' | head -n 1)

Managed services
EOF
  while read -r service; do
    printf '  %-22s %s\n' "$service" "$(systemctl is-active "$service.service")"
  done < <(service_names)
}

buddy_runtime_version() {
  local service
  service=$(engine_json manticore | jq -r 'keys | first // empty')
  [[ -n "$service" ]] || return 0
  journalctl -b -u "$service" --no-pager \
    | sed -n 's/.*\[BUDDY\] started v\([^ ]*\).*/\1/p' \
    | tail -n 1
}

cmd_versions() {
  require_repo
  local pins components buddy
  pins=$(jq -c '.versions' "$OPERATOR_CONFIG")
  components=$(nix eval --json "$FLAKE.manticore.package.componentVersions")
  buddy=$(buddy_runtime_version)
  [[ -n "$buddy" ]] || buddy="not observed in current boot"

  printf '%-24s %-34s %s\n' "Component" "Declared/bundled" "Runtime"
  printf '%-24s %-34s %s\n' "NixOS" "downstream host input" "$(nixos-version)"
  printf '%-24s %-34s %s\n' "MongoDB" "$(jq -r .mongodb <<<"$pins")" \
    "$(mongod --version | awk '/db version/ { sub(/^v/, "", $3); print $3; exit }')"
  printf '%-24s %-34s %s\n' "MySQL" "$(jq -r .mysql <<<"$pins")" \
    "$(mysql --version | awk '{ for (i=1; i<=NF; i++) if ($i=="Ver") { print $(i+1); exit } }')"
  printf '%-24s %-34s %s\n' "Manticore Search" "$(jq -r .search <<<"$components")" \
    "$(searchd --version 2>&1 | sed -n 's/^Manticore \([^ ]*\).*/\1/p' | head -n 1)"
  printf '%-24s %-34s %s\n' "Manticore Buddy" "$(jq -r .buddy <<<"$components")" "$buddy"
  for component in columnar secondary knn embeddings executor backup load tzdata galera; do
    printf '%-24s %-34s %s\n' "Manticore $component" \
      "$(jq -r --arg key "$component" '.[$key]' <<<"$components")" "bundle pin"
  done
}

cmd_quotas() {
  local mount
  while read -r mount; do
    echo "XFS project quotas on $mount"
    xfs_quota -x -c 'report -p -h' "$mount"
    echo
  done < <(instances_json | jq -r '.[].mountPoint' | sort -u)
}

human_systemd_value() {
  local value=$1
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    numfmt --to=iec-i --suffix=B "$value"
  else
    echo "$value"
  fi
}

cmd_resources() {
  require_repo
  local current high max swap cpu_quota allowed
  echo "database.slice"
  current=$(systemctl show database.slice -p MemoryCurrent --value)
  high=$(systemctl show database.slice -p MemoryHigh --value)
  max=$(systemctl show database.slice -p MemoryMax --value)
  swap=$(systemctl show database.slice -p MemorySwapMax --value)
  cpu_quota=$(systemctl show database.slice -p CPUQuotaPerSecUSec --value)
  allowed=$(systemctl show database.slice -p AllowedCPUs --value)
  printf '  current=%s high=%s max=%s swap=%s cpuQuota=%s allowedCPUs=%s\n' \
    "$(human_systemd_value "$current")" "$(human_systemd_value "$high")" \
    "$(human_systemd_value "$max")" "$(human_systemd_value "$swap")" \
    "$cpu_quota" "${allowed:-all}"

  echo
  printf '%-22s %8s %12s %12s %12s %12s %s\n' \
    "Service" "CPUWeight" "Current" "High" "Max" "SwapMax" "CPUQuota"
  while read -r service; do
    current=$(systemctl show "$service.service" -p MemoryCurrent --value)
    high=$(systemctl show "$service.service" -p MemoryHigh --value)
    max=$(systemctl show "$service.service" -p MemoryMax --value)
    swap=$(systemctl show "$service.service" -p MemorySwapMax --value)
    cpu_quota=$(systemctl show "$service.service" -p CPUQuotaPerSecUSec --value)
    printf '%-22s %8s %12s %12s %12s %12s %s\n' \
      "$service" "$(systemctl show "$service.service" -p CPUWeight --value)" \
      "$(human_systemd_value "$current")" "$(human_systemd_value "$high")" \
      "$(human_systemd_value "$max")" "$(human_systemd_value "$swap")" "$cpu_quota"
  done < <(service_names)
}

cmd_config() {
  require_repo
  local mongo mysql manticore
  mongo=$(engine_json mongodb)
  mysql=$(engine_json mysql)
  manticore=$(engine_json manticore)

  cat <<EOF
Main inventory:
$INVENTORY

Passwords are intentionally masked. The inventory is the source of truth for
ports, paths, XFS project IDs/quotas, CPU/memory, caches, users, and passwords.

EOF
  {
    printf 'Instance\tEngine\tPorts\tData directory\tMount\tProject\tQuota\tCPU\tMemoryHigh\tMemoryMax\tCache/buffer\n'
    jq -r 'to_entries[] | [.key,"mongodb",(.value.port|tostring),.value.dataDir,.value.mountPoint,(.value.projectId|tostring),.value.diskLimit,(.value.cpuWeight|tostring),.value.memoryHigh,.value.memoryMax,((.value.cacheGB|tostring)+"G WT")] | @tsv' <<<"$mongo"
    jq -r 'to_entries[] | [.key,"mysql",(.value.port|tostring),.value.dataDir,.value.mountPoint,(.value.projectId|tostring),.value.diskLimit,(.value.cpuWeight|tostring),.value.memoryHigh,.value.memoryMax,(.value.bufferPool+" InnoDB")] | @tsv' <<<"$mysql"
    jq -r 'to_entries[] | [.key,"manticore",((.value.sqlPort|tostring)+","+(.value.httpPort|tostring)),.value.dataDir,.value.mountPoint,(.value.projectId|tostring),.value.diskLimit,(.value.cpuWeight|tostring),.value.memoryHigh,.value.memoryMax,"engine"] | @tsv' <<<"$manticore"
  } | column -t -s $'\t'
  echo
  echo "Edit configuration in the Git repository, commit/push it, then deploy with:"
  echo "  sudo nixdb update --main"
  echo "or deploy an immutable release tag with:"
  echo "  sudo nixdb deploy v${INSTALLED_VERSION}"
}

validate_instance() {
  local requested=$1
  service_names | grep -Fxq -- "$requested" || die "unknown nixdb instance: $requested"
}

cmd_logs() {
  [[ $# -eq 1 ]] || die "usage: nixdb logs <instance>"
  validate_instance "$1"
  journalctl -b -u "$1.service" -n 200 --no-pager
}

size_bytes() {
  numfmt --from=iec "${1^^}"
}

size_kib() {
  local bytes
  bytes=$(size_bytes "$1")
  echo $(( (bytes + 1023) / 1024 ))
}

probe_host() {
  case "$1" in
    0.0.0.0) echo 127.0.0.1 ;;
    ::|"[::]") echo ::1 ;;
    *) echo "$1" ;;
  esac
}

check_units_and_ports() {
  local data service address port listener failed
  data=$(instances_json)
  while read -r service; do
    systemctl is-active --quiet "$service.service" || die "$service.service is not active"
  done < <(jq -r '.[].serviceName' <<<"$data")
  systemctl is-active --quiet databases.target || die "databases.target is not active"
  failed=$(systemctl --failed --no-legend --plain | wc -l)
  (( failed == 0 )) || die "$failed failed systemd units"

  while IFS=$'\t' read -r address port; do
    listener=$(ss -H -lnt "sport = :$port")
    if [[ "$address" == *:* ]]; then
      grep -Fq "[$address]:$port" <<<"$listener" || die "tcp/$port is not listening on $address"
    else
      grep -Fq "$address:$port" <<<"$listener" || die "tcp/$port is not listening on $address"
    fi
  done < <(jq -r '.[] | .listeners[] | [.address, (.port|tostring)] | @tsv' <<<"$data")
  echo "  units/listeners: PASS"
}

check_filesystems_and_quotas() {
  local data mount fstype options project limit expected actual
  data=$(instances_json)
  while read -r mount; do
    fstype=$(findmnt -n -o FSTYPE --target "$mount")
    options=$(findmnt -n -o OPTIONS --target "$mount")
    [[ "$fstype" == "xfs" ]] || die "$mount is not XFS"
    grep -Eq '(^|,)prjquota(,|$)' <<<"$options" || die "$mount is missing prjquota"
  done < <(jq -r '.[].mountPoint' <<<"$data" | sort -u)

  while IFS=$'\t' read -r mount project limit; do
    expected=$(size_kib "$limit")
    actual=$(xfs_quota -x -c 'report -p -b -N' "$mount" \
      | awk -v id="#$project" '$1 == id { print $4; exit }')
    [[ -n "$actual" ]] || die "XFS project $project is absent on $mount"
    [[ "$actual" == "$expected" ]] \
      || die "XFS project $project on $mount has hard quota $actual KiB, expected $expected KiB"
  done < <(jq -r '.[] | [.mountPoint, (.projectId|tostring), .diskLimit] | @tsv' <<<"$data")
  echo "  XFS/prjquota/hard limits: PASS"
}

check_resources() {
  local data slice expected actual service cpu high max swap quota allowed
  data=$(instances_json)
  slice=$(nix eval --json "$FLAKE.slice")
  for field in memoryHigh memoryMax memorySwapMax; do
    expected=$(size_bytes "$(jq -r --arg field "$field" '.[$field]' <<<"$slice")")
    case "$field" in
      memoryHigh) actual=$(systemctl show database.slice -p MemoryHigh --value) ;;
      memoryMax) actual=$(systemctl show database.slice -p MemoryMax --value) ;;
      memorySwapMax) actual=$(systemctl show database.slice -p MemorySwapMax --value) ;;
    esac
    [[ "$actual" == "$expected" ]] || die "database.slice $field differs from inventory"
  done
  quota=$(systemctl show database.slice -p CPUQuotaPerSecUSec --value)
  allowed=$(systemctl show database.slice -p AllowedCPUs --value)
  [[ "$quota" == "infinity" && -z "$allowed" ]] || die "database.slice has a CPU quota or pinning"

  while IFS=$'\t' read -r service cpu high max swap; do
    [[ $(systemctl show "$service.service" -p CPUWeight --value) == "$cpu" ]] \
      || die "$service CPUWeight differs from inventory"
    [[ $(systemctl show "$service.service" -p MemoryHigh --value) == "$(size_bytes "$high")" ]] \
      || die "$service MemoryHigh differs from inventory"
    [[ $(systemctl show "$service.service" -p MemoryMax --value) == "$(size_bytes "$max")" ]] \
      || die "$service MemoryMax differs from inventory"
    [[ $(systemctl show "$service.service" -p MemorySwapMax --value) == "$(size_bytes "$swap")" ]] \
      || die "$service MemorySwapMax differs from inventory"
    quota=$(systemctl show "$service.service" -p CPUQuotaPerSecUSec --value)
    allowed=$(systemctl show "$service.service" -p AllowedCPUs --value)
    [[ "$quota" == "infinity" && -z "$allowed" ]] || die "$service has a CPU quota or pinning"
  done < <(jq -r '.[] | [.serviceName,(.cpuWeight|tostring),.memoryHigh,.memoryMax,.memorySwapMax] | @tsv' <<<"$data")
  echo "  cgroup resources: PASS"
}

check_mongodb_auth() {
  local data name address host port user password ping
  data=$(engine_json mongodb)
  while IFS= read -r row; do
    name=$(jq -r .key <<<"$row")
    address=$(jq -r .value.bindAddress <<<"$row")
    host=$(probe_host "$address")
    port=$(jq -r .value.port <<<"$row")
    user=$(jq -r .value.adminUser <<<"$row")
    password=$(jq -r .value.password <<<"$row")
    ping=$(mongosh --quiet --host "$host" --port "$port" \
      --username "$user" --password "$password" --authenticationDatabase admin \
      --eval 'db.adminCommand({ping:1}).ok')
    [[ "$ping" == *1* ]] || die "$name authenticated ping failed"
    if mongosh --quiet --host "$host" --port "$port" \
      --eval 'db.getSiblingDB("admin").getUsers()' >/dev/null 2>&1; then
      die "$name accepted unauthenticated privileged access"
    fi
    echo "  $name auth/unauth: PASS"
  done < <(jq -c 'to_entries[]' <<<"$data")
}

check_mysql_auth() {
  local data name address host port user password result expected_version
  data=$(engine_json mysql)
  expected_version=$(nix eval --raw "$FLAKE.mysql.declaredVersion")
  while IFS= read -r row; do
    name=$(jq -r .key <<<"$row")
    address=$(jq -r .value.bindAddress <<<"$row")
    host=$(probe_host "$address")
    port=$(jq -r .value.port <<<"$row")
    user=$(jq -r .value.adminUser <<<"$row")
    password=$(jq -r .value.password <<<"$row")
    result=$(MYSQL_PWD="$password" mysql --protocol=TCP --host="$host" \
      --port="$port" --user="$user" --ssl-mode=DISABLED --get-server-public-key \
      --batch --skip-column-names --execute='SELECT VERSION(),1;')
    [[ "$result" == "$expected_version"$'\t1' ]] || die "$name authenticated query/version failed"
    echo "  $name auth/query: PASS"
  done < <(jq -c 'to_entries[]' <<<"$data")
}

check_manticore_auth() {
  local data pins expected_search expected_buddy row name address host sql_port http_port user password table result code unauth body
  data=$(engine_json manticore)
  pins=$(jq -c '.versions' "$OPERATOR_CONFIG")
  expected_search=$(jq -r .manticore <<<"$pins")
  expected_buddy=$(jq -r .manticoreBuddy <<<"$pins")
  health_tmp=$(mktemp -d /run/nixdb-health.XXXXXX)
  chmod 0700 "$health_tmp"
  while IFS= read -r row; do
    name=$(jq -r .key <<<"$row")
    address=$(jq -r .value.bindAddress <<<"$row")
    host=$(probe_host "$address")
    sql_port=$(jq -r .value.sqlPort <<<"$row")
    http_port=$(jq -r .value.httpPort <<<"$row")
    user=$(jq -r .value.adminUser <<<"$row")
    password=$(jq -r .value.password <<<"$row")
    table="nixdb_health_${name//-/_}_$$"
    result=$(MYSQL_PWD="$password" mysql --protocol=TCP --host="$host" \
      --port="$sql_port" --user="$user" --ssl-mode=DISABLED \
      --batch --skip-column-names --execute="
        SHOW STATUS;
        SHOW VERSION;
        DROP TABLE IF EXISTS $table;
        CREATE TABLE $table(title text);
        INSERT INTO $table VALUES(1,'hello');
        SELECT id,title FROM $table;
        DROP TABLE $table;
      ")
    grep -Fq "$expected_search" <<<"$result" || die "$name Search version check failed"
    grep -Fq "$expected_buddy" <<<"$result" || die "$name Buddy SHOW VERSION check failed"
    grep -Fq $'1\thello' <<<"$result" || die "$name RT table check failed"
    body="$health_tmp/$name-http.json"
    code=$(curl --silent --show-error --output "$body" --write-out '%{http_code}' \
      --user "$user:$password" --data-binary 'SHOW STATUS' \
      "http://$host:$http_port/sql?mode=raw")
    if [[ "$code" != 200 ]] || ! grep -Fq 'uptime' "$body"; then
      die "$name authenticated HTTP failed"
    fi
    unauth=$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --data-binary 'SHOW STATUS' "http://$host:$http_port/sql?mode=raw")
    [[ "$unauth" == 401 ]] || die "$name unauthenticated HTTP was not rejected"
    if mysql --protocol=TCP --host="$host" --port="$sql_port" \
      --ssl-mode=DISABLED --execute='SHOW STATUS' >/dev/null 2>&1; then
      die "$name accepted unauthenticated SQL"
    fi
    journalctl -b -u "$name.service" --no-pager | grep -F '[BUDDY] started' >/dev/null \
      || die "$name Buddy start record missing"
    if journalctl -b -u "$name.service" --no-pager \
      | grep -Ei 'Buddy disabled|no manticore-buddy' >/dev/null; then
      die "$name reports disabled/missing Buddy"
    fi
    echo "  $name auth/Buddy/RT/HTTP: PASS"
  done < <(jq -c 'to_entries[]' <<<"$data")
  rm -rf -- "$health_tmp"
  health_tmp=""
}

run_health() {
  require_repo
  echo "nixdb health"
  check_units_and_ports
  check_filesystems_and_quotas
  check_resources
  check_mongodb_auth
  check_mysql_auth
  check_manticore_auth
  echo "nixdb health: PASS"
}

cmd_restart() {
  [[ $# -eq 1 ]] || die "usage: nixdb restart <instance>"
  validate_instance "$1"
  echo "Restarting $1.service"
  systemctl restart "$1.service"
  systemctl is-active --quiet "$1.service" || die "$1.service did not become active"
  run_health
}

current_generation() {
  nix-env --list-generations -p /nix/var/nix/profiles/system \
    | awk '$NF == "(current)" { print $1; exit }'
}

record_mapping() {
  local system_path=$1 revision=$2 key
  key=$(basename "$system_path")
  install -d -m 0700 "$STATE_DIR/generations"
  printf '%s\n' "$revision" >"$STATE_DIR/generations/$key"
  chmod 0600 "$STATE_DIR/generations/$key"
}

mapped_revision() {
  local system_path=$1 key marker
  key=$(basename "$system_path")
  marker="$STATE_DIR/generations/$key"
  if [[ -r "$marker" ]]; then
    tr -d '\n' <"$marker"
  else
    echo "unknown"
  fi
}

restore_deployment() {
  local rc=$? old_commit=$1 old_system=$2 old_generation=$3 lock_backup=$4
  trap - ERR INT TERM
  echo >&2
  echo "nixdb: deployment failed; restoring host lock and NixOS generation $old_generation" >&2
  install -m 0644 "$lock_backup" "$REPO/flake.lock" >&2 || true
  git -C "$REPO" restore --staged --worktree flake.lock >&2 || true
  git -C "$REPO" switch --detach "$old_commit" >&2 || true
  nix-env --switch-generation "$old_generation" -p /nix/var/nix/profiles/system >&2 || true
  "$old_system/bin/switch-to-configuration" switch >&2 || true
  if run_health >&2; then
    echo "nixdb: previous deployment restored and healthy" >&2
  else
    echo "nixdb: CRITICAL: automatic recovery health check failed" >&2
  fi
  exit "$rc"
}

deploy_input() {
  local target_ref=$1 target_label=$2 old_commit old_system old_generation old_input new_input new_system new_commit lock_backup
  require_clean
  old_commit=$(git -C "$REPO" rev-parse HEAD)
  old_system=$(readlink -f /run/current-system)
  old_generation=$(current_generation)
  old_input=$(locked_input_field rev)
  [[ -n "$old_generation" ]] || die "cannot determine current NixOS generation"
  record_mapping "$old_system" "$old_commit"

  deploy_tmp=$(mktemp -d /run/nixdb-deploy.XXXXXX)
  lock_backup="$deploy_tmp/flake.lock.before"
  install -m 0600 "$REPO/flake.lock" "$lock_backup"
  trap 'restore_deployment "$old_commit" "$old_system" "$old_generation" "$lock_backup"' ERR INT TERM

  echo "==> target only the $INPUT_NAME flake input"
  (
    cd "$REPO"
    nix flake lock --override-input "$INPUT_NAME" "${INPUT_URL}/${target_ref}"
  )
  new_input=$(locked_input_field rev)

  cat <<EOF
nixdb deployment
  Host source:        $old_commit
  nixdb input:        $old_input -> $new_input ($target_label)
  System generation:  $old_generation
  Current NixOS:      $old_system
EOF

  cd "$deploy_tmp"

  echo "==> nix flake check"
  nix flake check "$REPO"
  echo "==> nixos-rebuild build"
  nixos-rebuild build --flake "$REPO#$HOST"
  echo "==> nixos-rebuild test"
  nixos-rebuild test --flake "$REPO#$HOST"
  echo "==> pre-switch health"
  run_health
  echo "==> nixos-rebuild switch"
  nixos-rebuild switch --flake "$REPO#$HOST"
  echo "==> post-switch health"
  run_health

  new_system=$(readlink -f /run/current-system)
  if ! git -C "$REPO" diff --quiet -- flake.lock; then
    git -C "$REPO" add flake.lock
    git -C "$REPO" \
      -c user.name=nixdb \
      -c user.email=nixdb@localhost \
      commit -m "nixdb: deploy $target_label"
  fi
  new_commit=$(git -C "$REPO" rev-parse HEAD)
  record_mapping "$new_system" "$new_commit"
  require_clean
  trap - ERR INT TERM
  rm -rf -- "$deploy_tmp"
  deploy_tmp=""
  echo "nixdb: deployment succeeded"
  echo "  Host source: $new_commit"
  echo "  nixdb input: $new_input ($target_label)"
  echo "  System:      $new_system"
}

cmd_update() {
  local mode=${1:-stable} tag
  [[ $# -le 1 ]] || die "usage: nixdb update [--main]"
  [[ "$mode" == "stable" || "$mode" == "--main" ]] \
    || die "usage: nixdb update [--main]"
  require_clean
  if [[ "$mode" == "--main" ]]; then
    deploy_input main main
  else
    tag=$(latest_stable_tag)
    [[ -n "$tag" ]] || die "no stable v* tags found"
    deploy_input "$tag" "$tag"
  fi
}

cmd_deploy() {
  local requested
  [[ $# -eq 1 ]] || die "usage: nixdb deploy <tag-or-revision>"
  requested=$1
  [[ "$requested" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] \
    || die "deployment reference contains unsupported characters"
  require_clean
  deploy_input "$requested" "$requested"
}

restore_rollback_failure() {
  local rc=$? old_commit=$1 old_system=$2 old_generation=$3
  trap - ERR INT TERM
  echo "nixdb: rollback failed; restoring generation $old_generation" >&2
  nix-env --switch-generation "$old_generation" -p /nix/var/nix/profiles/system >&2 || true
  "$old_system/bin/switch-to-configuration" switch >&2 || true
  git -C "$REPO" switch --detach "$old_commit" >&2 || true
  run_health >&2 || echo "nixdb: CRITICAL: restored generation health failed" >&2
  exit "$rc"
}

cmd_rollback() {
  local old_commit old_system old_generation previous_generation previous_system revision
  require_clean
  old_commit=$(git -C "$REPO" rev-parse HEAD)
  old_system=$(readlink -f /run/current-system)
  old_generation=$(current_generation)
  previous_generation=$(nix-env --list-generations -p /nix/var/nix/profiles/system \
    | awk -v current="$old_generation" '$1 < current { previous=$1 } END { print previous }')
  [[ -n "$previous_generation" ]] || die "no previous NixOS generation is available"
  previous_system=$(readlink -f "/nix/var/nix/profiles/system-${previous_generation}-link")
  cat <<EOF
nixdb rollback
  Current generation:  $old_generation ($old_system)
  Target generation:   $previous_generation ($previous_system)
  Database contents are not rolled back.
EOF
  trap 'restore_rollback_failure "$old_commit" "$old_system" "$old_generation"' ERR INT TERM
  nixos-rebuild switch --rollback
  revision=$(mapped_revision "$(readlink -f /run/current-system)")
  if [[ "$revision" =~ ^[0-9a-f]{40}$ ]] \
    && git -C "$REPO" cat-file -e "${revision}^{commit}" 2>/dev/null; then
    git -C "$REPO" switch --detach "$revision"
  else
    echo "nixdb: source mapping unavailable; leaving checkout at $old_commit" >&2
  fi
  run_health
  trap - ERR INT TERM
  echo "nixdb: rollback succeeded"
  echo "  Active generation: $(current_generation)"
  echo "  Source revision:   $(git -C "$REPO" rev-parse HEAD)"
}

main() {
  local command=${1:-help}
  if [[ "$command" == "help" || "$command" == "--help" || "$command" == "-h" ]]; then
    show_help
    return
  fi
  shift || true
  need_root "$command" "$@"
  require_repo
  case "$command" in
    status) [[ $# -eq 0 ]] || die "usage: nixdb status"; cmd_status ;;
    health) [[ $# -eq 0 ]] || die "usage: nixdb health"; run_health ;;
    versions) [[ $# -eq 0 ]] || die "usage: nixdb versions"; cmd_versions ;;
    quotas) [[ $# -eq 0 ]] || die "usage: nixdb quotas"; cmd_quotas ;;
    resources) [[ $# -eq 0 ]] || die "usage: nixdb resources"; cmd_resources ;;
    config) [[ $# -eq 0 ]] || die "usage: nixdb config"; cmd_config ;;
    logs) cmd_logs "$@" ;;
    restart) cmd_restart "$@" ;;
    update) cmd_update "$@" ;;
    deploy) cmd_deploy "$@" ;;
    rollback) [[ $# -eq 0 ]] || die "usage: nixdb rollback"; cmd_rollback ;;
    *) die "unknown command: $command (run 'nixdb help')" ;;
  esac
}

main "$@"
