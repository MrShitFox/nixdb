#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -Eeuo pipefail

readonly OPERATOR_CONFIG="${NIXDB_OPERATOR_CONFIG:-/etc/nixdb/operator.json}"

operator_value() {
  local key=$1 fallback=$2
  if [[ -r "$OPERATOR_CONFIG" ]]; then
    jq -r --arg key "$key" --arg fallback "$fallback" '.[$key] // $fallback' "$OPERATOR_CONFIG"
  else
    printf '%s\n' "$fallback"
  fi
}

# These defaults deliberately remain overridable by explicit command-line
# context flags. That lets a CLI obtained through `nix run` operate a legacy
# host without inventing a separate bootstrap program. `need_root` removes all
# NIXDB_* environment overrides before privilege escalation.
CONFIG_ROOT="${NIXDB_CONFIG_ROOT:-$(operator_value configRoot /etc/nixos)}"
FLAKE_HOST="${NIXDB_HOST:-$(operator_value flakeHost "$(hostname)")}"
INPUT_NAME="${NIXDB_INPUT_NAME:-$(operator_value inputName nixdb)}"
INPUT_URL="${NIXDB_INPUT_URL:-$(operator_value inputUrl github:MrShitFox/nixdb)}"
readonly RELEASE_REPOSITORY="${NIXDB_RELEASE_REPOSITORY:-$(operator_value releaseRepository https://github.com/MrShitFox/nixdb.git)}"
readonly MANIFEST="${NIXDB_MANIFEST:-$(operator_value manifestPath /etc/nixdb/manifest.json)}"
readonly HEALTH_CREDENTIALS="${NIXDB_HEALTH_CREDENTIALS:-$(operator_value healthCredentialsPath /etc/nixdb/health-credentials.json)}"
readonly STATE_DIR="${NIXDB_STATE_DIR:-/var/lib/nixdb}"
readonly DEPLOY_LOCK="${NIXDB_DEPLOY_LOCK:-/run/lock/nixdb-deploy.lock}"
readonly SYSTEM_PROFILE="${NIXDB_SYSTEM_PROFILE:-/nix/var/nix/profiles/system}"
readonly CURRENT_SYSTEM="${NIXDB_CURRENT_SYSTEM:-/run/current-system}"
readonly DEFAULT_READY_TIMEOUT=60
readonly READY_RETRY_INTERVAL=1

work_tmp=""
health_tmp=""
lock_fd=""

tx_activation_started=0
tx_old_commit=""
tx_old_branch=""
tx_old_system=""
tx_old_generation=""
tx_lock_backup=""
tx_lock_temp=""
deployment_phase="not started"

plan_ref=""
plan_label=""
candidate_input_url=""
candidate_input_metadata='{}'

cleanup() {
  if [[ -n "$health_tmp" && -d "$health_tmp" ]]; then
    rm -rf -- "$health_tmp"
  fi
  if [[ -n "$work_tmp" && -d "$work_tmp" ]]; then
    rm -rf -- "$work_tmp"
  fi
  if [[ -n "$tx_lock_temp" ]]; then
    rm -f -- "$tx_lock_temp"
  fi
}
trap cleanup EXIT

die() {
  echo "nixdb: $*" >&2
  exit 1
}

warn() {
  echo "nixdb: WARNING: $*" >&2
}

need_root() {
  if ! is_root; then
    # Do not carry test/operator path overrides across the privilege boundary.
    # Do this explicitly rather than relying only on a site's sudo env_reset
    # policy. Context passed as command-line flags is intentionally retained.
    exec env \
      -u NIXDB_CONFIG_ROOT \
      -u NIXDB_HOST \
      -u NIXDB_INPUT_NAME \
      -u NIXDB_INPUT_URL \
      -u NIXDB_OPERATOR_CONFIG \
      -u NIXDB_MANIFEST \
      -u NIXDB_HEALTH_CREDENTIALS \
      -u NIXDB_STATE_DIR \
      -u NIXDB_DEPLOY_LOCK \
      -u NIXDB_SYSTEM_PROFILE \
      -u NIXDB_CURRENT_SYSTEM \
      -u NIXDB_SOURCE_ONLY \
      sudo -- "$0" "$@"
  fi
}

is_root() {
  (( EUID == 0 ))
}

manifest_json() {
  [[ -r "$MANIFEST" ]] || die "runtime manifest is missing or unreadable: $MANIFEST"
  jq -e '
    .schemaVersion == 1
    and (.framework | type == "object")
    and (.versions | type == "object")
    and (.instances | type == "array")
  ' "$MANIFEST" >/dev/null || die "unsupported or invalid runtime manifest (expected schemaVersion 1): $MANIFEST"
  cat -- "$MANIFEST"
}

legacy_version_manifest() {
  jq -ce '
    select(.frameworkVersion != null and .frameworkRevision != null and (.versions | type == "object"))
    | {
        schemaVersion: 0,
        framework: {version: .frameworkVersion, revision: .frameworkRevision},
        versions: {
          mongodb: .versions.mongodb,
          mysql: .versions.mysql,
          manticore: .versions.manticore,
          manticoreComponents: {
            search: .versions.manticore,
            buddy: .versions.manticoreBuddy,
            columnar: .versions.manticoreColumnar,
            secondary: .versions.manticoreSecondary,
            knn: .versions.manticoreKnn,
            embeddings: .versions.manticoreEmbeddings,
            executor: .versions.manticoreExecutor,
            backup: .versions.manticoreBackup,
            load: .versions.manticoreLoad,
            tzdata: .versions.manticoreTzdata,
            galera: .versions.manticoreGalera
          }
        },
        instances: []
      }
    | select(
        .versions.mongodb != null
        and .versions.mysql != null
        and .versions.manticore != null
        and ([.versions.manticoreComponents[]] | all(. != null))
      )
  ' "$@"
}

active_version_manifest() {
  if [[ -r "$MANIFEST" ]] \
    && jq -e '.schemaVersion == 1 and (.versions | type == "object")' "$MANIFEST" >/dev/null 2>&1; then
    cat -- "$MANIFEST"
    return
  fi

  # v0.2.0 predates the sanitized runtime manifest, but its declarative
  # operator file contains the exact framework and bundled DB versions needed
  # for the pre-activation upgrade guard. This fallback is deliberately
  # version-only: read-only instance operations still require schema 1.
  [[ -r "$OPERATOR_CONFIG" ]] \
    || die "active version metadata is unavailable (no schema-1 manifest or legacy operator config)"
  legacy_version_manifest "$OPERATOR_CONFIG" \
    || die "legacy operator config lacks complete DB version metadata"
}

credentials_json() {
  [[ -r "$HEALTH_CREDENTIALS" ]] \
    || die "root-only health credentials are missing or unreadable: $HEALTH_CREDENTIALS"
  jq -e '.schemaVersion == 1 and (.instances | type == "array")' "$HEALTH_CREDENTIALS" >/dev/null \
    || die "unsupported health credential schema: $HEALTH_CREDENTIALS"
  cat -- "$HEALTH_CREDENTIALS"
}

instances_json() {
  manifest_json | jq -c '.instances'
}

service_names() {
  instances_json | jq -r '.[].serviceName'
}

require_deployment_repo() {
  git -C "$CONFIG_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "$CONFIG_ROOT is not a Git checkout; deployment commands require Git"
  [[ -f "$CONFIG_ROOT/flake.nix" ]] || die "flake.nix not found in $CONFIG_ROOT"
  [[ -f "$CONFIG_ROOT/flake.lock" ]] || die "flake.lock not found in $CONFIG_ROOT"
}

require_clean() {
  local changes
  changes=$(git -C "$CONFIG_ROOT" status --porcelain --untracked-files=all)
  if [[ -n "$changes" ]]; then
    printf '%s\n' "$changes" >&2
    die "$CONFIG_ROOT must be clean before planning or deployment"
  fi
}

acquire_deployment_lock() {
  install -d -m 0755 "$(dirname "$DEPLOY_LOCK")"
  exec {lock_fd}>"$DEPLOY_LOCK"
  flock -n "$lock_fd" \
    || die "another nixdb deployment operation is already running"
}

latest_stable_tag() {
  git ls-remote --refs --tags "$RELEASE_REPOSITORY" 'refs/tags/v*' 2>/dev/null \
    | awk '$2 ~ /^refs\/tags\/v[0-9]+\.[0-9]+\.[0-9]+$/ {
        sub("refs/tags/", "", $2)
        print $2
      }' \
    | sort -V \
    | tail -n 1
}

validate_ref() {
  local requested=$1
  [[ ${#requested} -le 160 ]] || die "deployment reference is too long"
  [[ "$requested" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] \
    || die "deployment reference contains unsupported characters"
  [[ "$requested" != *..* && "$requested" != *//* && "$requested" != */ && "$requested" != *.lock ]] \
    || die "deployment reference is not a safe Git ref or revision"
  if [[ ! "$requested" =~ ^[0-9a-fA-F]{40}$ ]]; then
    git check-ref-format "refs/nixdb-target/$requested" >/dev/null 2>&1 \
      || die "deployment reference is not a valid Git ref"
  fi
}

lock_node_from() {
  local lock_file=$1
  jq -r --arg name "$INPUT_NAME" \
    '.nodes.root.inputs[$name] | if type == "array" then .[-1] else . end // empty' \
    "$lock_file"
}

locked_input_field_from() {
  local lock_file=$1 field=$2 node
  [[ -r "$lock_file" ]] || {
    echo ''
    return
  }
  node=$(lock_node_from "$lock_file")
  [[ -n "$node" ]] || {
    echo ''
    return
  }
  jq -r --arg node "$node" --arg field "$field" \
    '.nodes[$node].locked[$field] // empty' \
    "$lock_file"
}

locked_input_json_from() {
  local lock_file=$1 node
  [[ -r "$lock_file" ]] || {
    echo '{}'
    return
  }
  node=$(lock_node_from "$lock_file")
  [[ -n "$node" ]] || {
    echo '{}'
    return
  }
  jq -c --arg node "$node" '{original:.nodes[$node].original,locked:.nodes[$node].locked}' "$lock_file"
}

configured_input_json_from() {
  local lock_file=$1 node
  [[ -r "$lock_file" ]] || {
    echo null
    return
  }
  node=$(lock_node_from "$lock_file")
  [[ -n "$node" ]] || {
    echo null
    return
  }
  jq -c --arg node "$node" '.nodes[$node].original // null' "$lock_file"
}

configured_input_description() {
  jq -r '
    if . == null then "unavailable"
    elif .type == "github" then
      "github:" + (.owner // "?") + "/" + (.repo // "?")
      + (if .ref == null then "" else "/" + .ref end)
    elif .type == "path" then "path:" + (.path // "?")
    elif .type == "git" then (.url // "git input")
    else (.type // "unknown input")
    end
  '
}

release_tag_for_revision() {
  local revision=$1
  [[ "$revision" =~ ^[0-9a-fA-F]{40}$ ]] || return 1
  git ls-remote --tags "$RELEASE_REPOSITORY" 'refs/tags/v*' 2>/dev/null \
    | awk -v revision="$revision" '
        $1 == revision && $2 ~ /^refs\/tags\/v[0-9]+\.[0-9]+\.[0-9]+(\^\{\})?$/ {
          tag = $2
          sub(/^refs\/tags\//, "", tag)
          sub(/\^\{\}$/, "", tag)
          print tag
        }
      ' \
    | sort -Vu \
    | tail -n 1
}

input_metadata_json_from() {
  local lock_file=$1 configured locked revision release state
  configured=$(configured_input_json_from "$lock_file")
  locked=$(locked_input_json_from "$lock_file")
  revision=$(locked_input_field_from "$lock_file" rev)
  state=unavailable
  release=null

  if [[ "$configured" == null && "$locked" == '{}' ]]; then
    state=unavailable
  elif [[ $(jq -r '.type // empty' <<<"$configured") == path ]]; then
    state=not-applicable
  elif [[ ! "$revision" =~ ^[0-9a-fA-F]{40}$ ]]; then
    state=not-applicable
  else
    if release=$(release_tag_for_revision "$revision"); then
      if [[ -n "$release" ]]; then
        state=tagged
        release=$(jq -Rn --arg value "$release" '$value')
      else
        state=untagged
        release=null
      fi
    else
      # Do not call an input untagged merely because the tag source could not
      # be consulted. The distinction is surfaced in both text and JSON.
      state=unavailable
      release=null
    fi
  fi

  jq -cn \
    --argjson configured "$configured" \
    --argjson locked "$locked" \
    --arg revision "$revision" \
    --arg state "$state" \
    --argjson release "$release" \
    '{configuredInput:$configured,locked:$locked,
      lockedRevision:(if $revision == "" then null else $revision end),
      resolvedRelease:$release,resolvedReleaseState:$state}'
}

resolved_release_description() {
  local metadata=$1 state release
  state=$(jq -r .resolvedReleaseState <<<"$metadata")
  release=$(jq -r '.resolvedRelease // empty' <<<"$metadata")
  case "$state" in
    tagged) printf '%s\n' "$release" ;;
    untagged) echo untagged ;;
    not-applicable) echo 'not applicable (path/non-revision input)' ;;
    *) echo unavailable ;;
  esac
}

runtime_mongodb_version() {
  if command -v mongod >/dev/null 2>&1; then
    mongod --version 2>/dev/null | awk '/db version/ { sub(/^v/, "", $3); print $3; exit }'
  else
    echo unavailable
  fi
}

runtime_mysql_version() {
  if command -v mysql >/dev/null 2>&1; then
    mysql --version 2>/dev/null \
      | awk '{ for (i=1; i<=NF; i++) if ($i=="Ver") { print $(i+1); exit } }'
  else
    echo unavailable
  fi
}

runtime_manticore_version() {
  if command -v searchd >/dev/null 2>&1; then
    searchd --version 2>&1 | sed -n 's/^Manticore \([^ ]*\).*/\1/p' | head -n 1
  else
    echo unavailable
  fi
}

buddy_runtime_version() {
  local service
  service=$(instances_json | jq -r '[.[] | select(.engine == "manticore")][0].serviceName // empty')
  [[ -n "$service" ]] || {
    echo not-configured
    return
  }
  journalctl -b -u "$service.service" --no-pager 2>/dev/null \
    | sed -n 's/.*\[BUDDY\] started v\([^ ]*\).*/\1/p' \
    | tail -n 1 \
    | grep . || echo not-observed
}

source_checkout_json() {
  if [[ ! -e "$CONFIG_ROOT" ]]; then
    jq -cn '{state:"missing",commit:null,branch:null,clean:null}'
  elif [[ ! -d "$CONFIG_ROOT" ]]; then
    jq -cn '{state:"not a directory",commit:null,branch:null,clean:null}'
  elif [[ ! -r "$CONFIG_ROOT" || ! -x "$CONFIG_ROOT" ]]; then
    jq -cn '{state:"requires root",commit:null,branch:null,clean:null}'
  elif git -C "$CONFIG_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local head branch clean
    head=$(git -C "$CONFIG_ROOT" rev-parse --verify HEAD)
    branch=$(git -C "$CONFIG_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || echo detached)
    if [[ -z $(git -C "$CONFIG_ROOT" status --porcelain --untracked-files=all) ]]; then
      clean=true
    else
      clean=false
    fi
    jq -cn --arg state git --arg head "$head" --arg branch "$branch" --argjson clean "$clean" \
      '{state:$state,commit:$head,branch:$branch,clean:$clean}'
  else
    jq -cn '{state:"not a Git checkout",commit:null,branch:null,clean:null}'
  fi
}

deployment_state_json() {
  local path="$STATE_DIR/deployment-state.json"
  if [[ ! -e "$path" ]]; then
    jq -cn '{availability:"absent",record:null}'
  elif [[ ! -r "$path" ]]; then
    jq -cn '{availability:"requires root",record:null}'
  elif jq -e '
      (.schemaVersion == 1 or .schemaVersion == 2)
      and (.system | type == "string")
      and (.generation | type == "string")
      and (.hostRevision | type == "string")
      and (.framework | type == "object")
      and (.dbVersions | type == "object")
      and (.previous | type == "object")
    ' "$path" >/dev/null 2>&1; then
    jq -cn --argjson record "$(cat "$path")" '{availability:"valid",record:$record}'
  else
    jq -cn '{availability:"invalid",record:null}'
  fi
}

lock_file_is_dirty() {
  [[ $(jq -r .state <<<"$(source_checkout_json)") == git ]] \
    && ! git -C "$CONFIG_ROOT" diff --quiet -- flake.lock
}

deployment_description() {
  local manifest=$1 input=$2 source=$3 state=$4 runtime_revision locked_revision
  local source_state source_clean state_availability state_system active_system locked_release installed_release
  local input_state state_lock_hash current_lock_hash state_version state_revision runtime_version
  runtime_revision=$(jq -r .framework.revision <<<"$manifest")
  locked_revision=$(jq -r '.lockedRevision // empty' <<<"$input")
  source_state=$(jq -r .state <<<"$source")
  source_clean=$(jq -r 'if .clean == null then "unknown" else .clean end' <<<"$source")
  state_availability=$(jq -r .availability <<<"$state")
  input_state=$(jq -r .resolvedReleaseState <<<"$input")

  if [[ "$source_state" == git && "$source_clean" == false ]] && lock_file_is_dirty; then
    echo 'incomplete candidate activation (dirty flake.lock)'
    return
  fi

  if [[ "$state_availability" == valid ]]; then
    state_system=$(jq -r .record.system <<<"$state")
    active_system=$(readlink -f "$CURRENT_SYSTEM" 2>/dev/null || true)
    if [[ -n "$active_system" && "$active_system" != "$state_system" ]] \
      && [[ "$source_clean" == false ]]; then
      echo 'incomplete candidate activation (active system differs from last successful deployment)'
      return
    fi

    # Path inputs do not have a Git revision, so compare the exact lock hash,
    # recorded framework identity, and active system instead of pretending the
    # lock is unavailable.  The state file is operational evidence, never an
    # alternate source of configuration.
    if [[ "$input_state" == not-applicable ]]; then
      state_lock_hash=$(jq -r '.record.source.lockSha256 // empty' <<<"$state")
      state_version=$(jq -r '.record.framework.version // empty' <<<"$state")
      state_revision=$(jq -r '.record.framework.revision // empty' <<<"$state")
      runtime_version=$(jq -r .framework.version <<<"$manifest")
      current_lock_hash=$(sha256sum "$CONFIG_ROOT/flake.lock" 2>/dev/null | awk '{print $1}')
      if [[ -n "$active_system" && "$active_system" == "$state_system" ]] \
        && [[ -n "$state_lock_hash" && "$current_lock_hash" == "$state_lock_hash" ]] \
        && [[ "$runtime_version" == "$state_version" && "$runtime_revision" == "$state_revision" ]]; then
        echo 'path input matches active system'
        return
      fi
    fi
  fi

  if [[ -z "$locked_revision" ]]; then
    echo 'host flake input unavailable'
  elif [[ "$locked_revision" == "$runtime_revision" ]]; then
    if [[ "$source_state" == git && "$source_clean" == false ]]; then
      echo 'source has pending unactivated changes'
    else
      echo 'locked input matches active system'
    fi
  elif [[ "$source_state" == git && "$source_clean" == false ]]; then
    echo 'incomplete candidate activation (locked input differs from active system)'
  else
    locked_release=$(jq -r '.resolvedRelease // empty' <<<"$input")
    installed_release="v$(jq -r .framework.version <<<"$manifest")"
    if [[ "$locked_release" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] \
      && [[ "$installed_release" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      if [[ "$locked_release" == "$installed_release" ]]; then
        echo 'locked input differs from active system'
      elif [[ $(printf '%s\n%s\n' "$installed_release" "$locked_release" | sort -V | head -n 1) == "$installed_release" ]]; then
        echo 'lock ahead of active runtime'
      else
        echo 'active runtime ahead of lock'
      fi
    else
      # Without a total ordering for arbitrary revisions, this intentionally
      # describes the observed state rather than guessing which side is newer.
      echo 'locked input differs from active system'
    fi
  fi
}

show_help() {
  cat <<'EOF'
nixdb - operate the nixdb NixOS database stack

READ ONLY
  nixdb status [--json]          Runtime, framework input, versions, and units
  nixdb health                   Full storage/resource/authentication checks
  nixdb wait [instance] [--timeout <seconds>]
                                  Wait for authenticated database readiness
  nixdb doctor                   Operator and host prerequisite checks
  nixdb versions [--json]        Declared and observed component versions
  nixdb quotas                   XFS project quota reports
  nixdb resources                Slice and per-instance cgroup resources
  nixdb config                   Sanitized evaluated inventory summary
  nixdb logs <instance>          Recent journal entries for one DB instance

MUTATING SERVICE
  nixdb restart <instance>       Restart one validated DB unit, then check health

DEPLOYMENT
  nixdb plan [--latest]          Plan newest stable vMAJOR.MINOR.PATCH release
  nixdb plan --main              Plan the development main input
  nixdb plan <tag-or-revision>   Plan an exact public ref without changing files
  nixdb update                   Deploy newest stable vMAJOR.MINOR.PATCH release
  nixdb update --main            Explicitly deploy development main
  nixdb update --allow-db-upgrade
  nixdb deploy <ref> [--allow-db-upgrade]
  nixdb deploy --input-url <flake-ref> [--allow-db-upgrade]
  nixdb rollback [--allow-db-binary-rollback]

BOOTSTRAP CONTEXT
  nixdb --config-root <path> --flake-host <host> --input-name <name> <command>

Database package changes are blocked before nixos-rebuild test unless
--allow-db-upgrade is explicitly supplied. Rollback changes NixOS/system
configuration only; it never rolls back database contents or file formats.
EOF
}

cmd_status() {
  local output=${1:-text} manifest source latest input deployment_record deployment failed services
  local configured_description locked_revision resolved_description
  [[ "$output" == text || "$output" == --json ]] || die "usage: nixdb status [--json]"
  manifest=$(manifest_json)
  source=$(source_checkout_json)
  latest=$(latest_stable_tag || true)
  [[ -n "$latest" ]] || latest=unavailable
  input=$(input_metadata_json_from "$CONFIG_ROOT/flake.lock")
  configured_description=$(jq -c .configuredInput <<<"$input" | configured_input_description)
  locked_revision=$(jq -r '.lockedRevision // "unavailable"' <<<"$input")
  resolved_description=$(resolved_release_description "$input")
  deployment_record=$(deployment_state_json)
  deployment=$(deployment_description "$manifest" "$input" "$source" "$deployment_record")
  failed=$(systemctl --failed --no-legend --plain 2>/dev/null | wc -l)
  services=$(while read -r service; do
    jq -cn --arg name "$service" --arg state "$(systemctl is-active "$service.service" 2>/dev/null || true)" \
      '{name:$name,state:$state}'
  done < <(service_names) | jq -sc .)

  if [[ "$output" == --json ]]; then
    jq -cn \
      --arg host "$(hostname)" \
      --arg configRoot "$CONFIG_ROOT" \
      --arg configHint "$(jq -r .operator.configHint <<<"$manifest")" \
      --arg latest "$latest" \
      --arg deployment "$deployment" \
      --arg nixos "$(nixos-version 2>/dev/null || echo unavailable)" \
      --arg target "$(systemctl is-active databases.target 2>/dev/null || true)" \
      --argjson failed "$failed" \
      --argjson source "$source" \
      --argjson input "$input" \
      --argjson deploymentRecord "$deployment_record" \
      --argjson manifest "$manifest" \
      --argjson services "$services" \
      '{host:$host,configRoot:$configRoot,configHint:$configHint,sourceCheckout:$source,
        framework:{installed:$manifest.framework,configuredInput:$input.configuredInput,
          locked:$input.locked,lockedRevision:$input.lockedRevision,
          resolvedRelease:$input.resolvedRelease,resolvedReleaseState:$input.resolvedReleaseState,
          latestStable:$latest,deploymentState:$deployment},deploymentRecord:$deploymentRecord,nixos:$nixos,
        databasesTarget:$target,failedSystemUnits:$failed,versions:$manifest.versions,
        services:$services}'
    return
  fi

  cat <<EOF
nixdb status
  Host:                  $(hostname)
  Host config root:      $CONFIG_ROOT
  Configuration hint:    $(jq -r .operator.configHint <<<"$manifest")
  Source checkout:       $(jq -r .state <<<"$source")
  Host Git commit:       $(jq -r '.commit // "unavailable"' <<<"$source")
  Host branch state:     $(jq -r '.branch // "unavailable"' <<<"$source")
  Host tree clean:       $(jq -r 'if .clean == null then "unavailable" else .clean end' <<<"$source")
  nixdb configured input: $configured_description
  nixdb locked revision: $locked_revision
  nixdb resolved release: $resolved_description
  nixdb installed:       $(jq -r '.framework.version + " (" + .framework.revision + ")"' <<<"$manifest")
  Latest stable nixdb:   $latest
  Deployment state:      $deployment
  NixOS:                 $(nixos-version 2>/dev/null || echo unavailable)
  databases.target:      $(systemctl is-active databases.target 2>/dev/null || true)
  Failed system units:   $failed

Database engines
  MongoDB:               $(runtime_mongodb_version)
  MySQL:                 $(runtime_mysql_version)
  Manticore Search:      $(runtime_manticore_version)

Managed services
EOF
  jq -r '.[] | "  \(.name)\t\(.state)"' <<<"$services" | column -t -s $'\t'
}

versions_json() {
  local manifest buddy
  manifest=$(manifest_json)
  buddy=$(buddy_runtime_version)
  jq -cn \
    --arg nixos "$(nixos-version 2>/dev/null || echo unavailable)" \
    --arg mongoRuntime "$(runtime_mongodb_version)" \
    --arg mysqlRuntime "$(runtime_mysql_version)" \
    --arg manticoreRuntime "$(runtime_manticore_version)" \
    --arg buddyRuntime "$buddy" \
    --argjson versions "$(jq -c .versions <<<"$manifest")" \
    '{nixos:{runtime:$nixos},mongodb:{declared:$versions.mongodb,runtime:$mongoRuntime},
      mysql:{declared:$versions.mysql,runtime:$mysqlRuntime},
      manticore:{declared:$versions.manticore,runtime:$manticoreRuntime,
        components:$versions.manticoreComponents,buddyRuntime:$buddyRuntime}}'
}

cmd_versions() {
  local output=${1:-text} data component
  [[ "$output" == text || "$output" == --json ]] || die "usage: nixdb versions [--json]"
  data=$(versions_json)
  if [[ "$output" == --json ]]; then
    jq . <<<"$data"
    return
  fi
  printf '%-24s %-34s %s\n' Component Declared/bundled Runtime
  printf '%-24s %-34s %s\n' NixOS 'downstream host input' "$(jq -r .nixos.runtime <<<"$data")"
  printf '%-24s %-34s %s\n' MongoDB "$(jq -r .mongodb.declared <<<"$data")" "$(jq -r .mongodb.runtime <<<"$data")"
  printf '%-24s %-34s %s\n' MySQL "$(jq -r .mysql.declared <<<"$data")" "$(jq -r .mysql.runtime <<<"$data")"
  printf '%-24s %-34s %s\n' 'Manticore Search' "$(jq -r .manticore.declared <<<"$data")" "$(jq -r .manticore.runtime <<<"$data")"
  printf '%-24s %-34s %s\n' 'Manticore Buddy' "$(jq -r .manticore.components.buddy <<<"$data")" "$(jq -r .manticore.buddyRuntime <<<"$data")"
  for component in columnar secondary knn embeddings executor backup load tzdata galera; do
    printf '%-24s %-34s %s\n' "Manticore $component" \
      "$(jq -r --arg key "$component" '.manticore.components[$key]' <<<"$data")" 'bundle pin'
  done
}

cmd_quotas() {
  local mount
  while read -r mount; do
    echo "XFS project quotas on $mount"
    xfs_quota -x -c 'report -p -h' "$mount"
    echo
  done < <(instances_json | jq -r '.[].mountPoint' | sort -u)
}

human_systemd_value() {
  local value=$1
  if [[ "$value" =~ ^[0-9]+$ ]]; then
    numfmt --to=iec-i --suffix=B "$value"
  else
    echo "$value"
  fi
}

cmd_resources() {
  local current high max swap cpu_quota allowed service
  manifest_json >/dev/null
  echo database.slice
  current=$(systemctl show database.slice -p MemoryCurrent --value)
  high=$(systemctl show database.slice -p MemoryHigh --value)
  max=$(systemctl show database.slice -p MemoryMax --value)
  swap=$(systemctl show database.slice -p MemorySwapMax --value)
  cpu_quota=$(systemctl show database.slice -p CPUQuotaPerSecUSec --value)
  allowed=$(systemctl show database.slice -p AllowedCPUs --value)
  printf '  current=%s high=%s max=%s swap=%s cpuQuota=%s allowedCPUs=%s\n' \
    "$(human_systemd_value "$current")" "$(human_systemd_value "$high")" \
    "$(human_systemd_value "$max")" "$(human_systemd_value "$swap")" \
    "$cpu_quota" "${allowed:-all}"
  echo
  printf '%-22s %8s %12s %12s %12s %12s %s\n' \
    Service CPUWeight Current High Max SwapMax CPUQuota
  while read -r service; do
    current=$(systemctl show "$service.service" -p MemoryCurrent --value)
    high=$(systemctl show "$service.service" -p MemoryHigh --value)
    max=$(systemctl show "$service.service" -p MemoryMax --value)
    swap=$(systemctl show "$service.service" -p MemorySwapMax --value)
    cpu_quota=$(systemctl show "$service.service" -p CPUQuotaPerSecUSec --value)
    printf '%-22s %8s %12s %12s %12s %12s %s\n' \
      "$service" "$(systemctl show "$service.service" -p CPUWeight --value)" \
      "$(human_systemd_value "$current")" "$(human_systemd_value "$high")" \
      "$(human_systemd_value "$max")" "$(human_systemd_value "$swap")" "$cpu_quota"
  done < <(service_names)
}

cmd_config() {
  local data
  data=$(manifest_json)
  cat <<EOF
Main configuration hint:
$(jq -r .operator.configHint <<<"$data")

This is a sanitized evaluated summary. Passwords are never present in the
runtime manifest or CLI output.

EOF
  {
    printf 'Instance\tEngine\tPorts\tData directory\tMount\tProject\tQuota\tCPU\tMemoryHigh\tMemoryMax\tCache/buffer\n'
    jq -r '.instances[] | [
      .name,.engine,(.ports|map(tostring)|join(",")),.dataDir,.mountPoint,
      (.projectId|tostring),.diskLimit,(.cpuWeight|tostring),.memoryHigh,.memoryMax,
      (if .internalCache == null then "-" else (.internalCache.value + " " + .internalCache.kind) end)
    ] | @tsv' <<<"$data"
  } | column -t -s $'\t'
  cat <<'EOF'

Edit the downstream host configuration, commit it, and then run `nixdb plan`
before deploying a stable release with `sudo nixdb update`.
EOF
}

validate_instance() {
  local requested=$1
  [[ "$requested" =~ ^[a-z][a-z0-9_-]{0,30}$ ]] \
    || die "invalid nixdb instance name: $requested"
  service_names | grep -Fxq -- "$requested" || die "unknown nixdb instance: $requested"
}

cmd_logs() {
  [[ $# -eq 1 ]] || die "usage: nixdb logs <instance>"
  validate_instance "$1"
  journalctl -b -u "$1.service" -n 200 --no-pager
}

size_bytes() {
  numfmt --from=iec "${1^^}"
}

size_kib() {
  local bytes
  bytes=$(size_bytes "$1")
  echo $(((bytes + 1023) / 1024))
}

probe_host() {
  case "$1" in
    0.0.0.0) echo 127.0.0.1 ;;
    ::|"[::]") echo ::1 ;;
    *) echo "$1" ;;
  esac
}

credential_for() {
  local name=$1
  credentials_json | jq -ce --arg name "$name" '.instances[] | select(.name == $name)'
}

check_units_and_ports() {
  local data service address port failed
  data=$(instances_json)
  while read -r service; do
    systemctl is-active --quiet "$service.service" || die "$service.service is not active"
  done < <(jq -r '.[].serviceName' <<<"$data")
  systemctl is-active --quiet databases.target || die "databases.target is not active"
  failed=$(systemctl --failed --no-legend --plain | wc -l)
  ((failed == 0)) || die "$failed failed systemd units"
  while IFS=$'\t' read -r address port; do
    listener_is_ready "$address" "$port" || die "tcp/$port is not listening on $address"
  done < <(jq -r '.[] | .listeners[] | [.address, (.port|tostring)] | @tsv' <<<"$data")
  echo '  units/listeners: PASS'
}

listener_is_ready() {
  local address=$1 port=$2 listener
  listener=$(ss -H -lnt "sport = :$port")
  if [[ "$address" == *:* ]]; then
    grep -Fq "[$address]:$port" <<<"$listener"
  else
    grep -Fq "$address:$port" <<<"$listener"
  fi
}

wait_instance_listeners() {
  local name=$1 address port ready attempt
  for ((attempt = 1; attempt <= 120; attempt++)); do
    ready=true
    while IFS=$'\t' read -r address port; do
      if ! listener_is_ready "$address" "$port"; then
        ready=false
        break
      fi
    done < <(
      instances_json \
        | jq -r --arg name "$name" '.[] | select(.name == $name) | .listeners[] | [.address, (.port|tostring)] | @tsv'
    )
    [[ "$ready" == true ]] && return
    systemctl is-failed --quiet "$name.service" \
      && die "$name.service failed while waiting for its listeners"
    sleep 0.5
  done
  die "$name.service did not open its configured listeners within 60 seconds"
}

retry_probe() {
  local label=$1 timeout=$2 interval=$3
  shift 3
  local deadline=$((SECONDS + timeout)) attempt=1 output rc=0
  while true; do
    if output=$("$@" 2>&1); then
      return 0
    else
      rc=$?
    fi
    if ((SECONDS >= deadline)); then
      printf 'nixdb: %s did not become ready within %ss; last probe error: %s\n' \
        "$label" "$timeout" "${output:-probe exited $rc without output}" >&2
      return 1
    fi
    attempt=$((attempt + 1))
    sleep "$interval"
  done
}

instance_listeners_ready() {
  local name=$1 address port
  while IFS=$'\t' read -r address port; do
    if ! listener_is_ready "$address" "$port"; then
      printf 'listener tcp/%s is not available on %s\n' "$port" "$address" >&2
      return 1
    fi
  done < <(
    instances_json \
      | jq -r --arg name "$name" '.[] | select(.name == $name) | .listeners[] | [.address, (.port|tostring)] | @tsv'
  )
}

probe_mongodb_ready() {
  local name=$1 credential host port user password ping
  credential=$(credential_for "$name")
  host=$(probe_host "$(jq -r .address <<<"$credential")")
  port=$(jq -r .ports.main <<<"$credential")
  user=$(jq -r .username <<<"$credential")
  password=$(jq -r .password <<<"$credential")
  if ! ping=$(mongosh --quiet --host "$host" --port "$port" --username "$user" \
    --password "$password" --authenticationDatabase admin --eval 'db.adminCommand({ping:1}).ok'); then
    echo 'authenticated MongoDB ping command failed' >&2
    return 1
  fi
  [[ "$ping" == *1* ]] || {
    echo 'authenticated MongoDB ping did not return ok:1' >&2
    return 1
  }
}

probe_mysql_ready() {
  local name=$1 credential host port user password result expected
  credential=$(credential_for "$name")
  host=$(probe_host "$(jq -r .address <<<"$credential")")
  port=$(jq -r .ports.main <<<"$credential")
  user=$(jq -r .username <<<"$credential")
  password=$(jq -r .password <<<"$credential")
  expected=$(manifest_json | jq -r .versions.mysql)
  if ! result=$(MYSQL_PWD="$password" mysql --protocol=TCP --host="$host" --port="$port" \
    --user="$user" --ssl-mode=DISABLED --get-server-public-key \
    --batch --skip-column-names --execute='SELECT VERSION(),1;'); then
    echo 'authenticated MySQL query command failed' >&2
    return 1
  fi
  [[ "$result" == "$expected"$'\t1' ]] || {
    echo "authenticated MySQL query/version returned unexpected result: $result" >&2
    return 1
  }
}

probe_manticore_ready() {
  local name=$1 credential host sql_port http_port user password result code expected_search expected_buddy
  credential=$(credential_for "$name")
  host=$(probe_host "$(jq -r .address <<<"$credential")")
  sql_port=$(jq -r .ports.sql <<<"$credential")
  http_port=$(jq -r .ports.http <<<"$credential")
  user=$(jq -r .username <<<"$credential")
  password=$(jq -r .password <<<"$credential")
  expected_search=$(manifest_json | jq -r .versions.manticore)
  expected_buddy=$(manifest_json | jq -r .versions.manticoreComponents.buddy)
  if ! result=$(MYSQL_PWD="$password" mysql --protocol=TCP --host="$host" --port="$sql_port" \
    --user="$user" --ssl-mode=DISABLED --batch --skip-column-names \
    --execute='SHOW STATUS; SHOW VERSION;'); then
    echo 'authenticated Manticore SQL readiness query failed' >&2
    return 1
  fi
  grep -Fq "$expected_search" <<<"$result" || {
    echo 'Manticore Search version is not ready' >&2
    return 1
  }
  grep -Fq "$expected_buddy" <<<"$result" || {
    echo 'Manticore Buddy SHOW VERSION is not ready' >&2
    return 1
  }
  if ! code=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    --user "$user:$password" --data-binary 'SHOW STATUS' "http://$host:$http_port/sql?mode=raw"); then
    echo 'authenticated Manticore HTTP readiness request failed' >&2
    return 1
  fi
  [[ "$code" == 200 ]] || {
    echo "authenticated Manticore HTTP readiness returned $code" >&2
    return 1
  }
}

instance_readiness_probe() {
  local name=$1 engine
  systemctl is-active --quiet "$name.service" || {
    echo "$name.service is not active" >&2
    return 1
  }
  instance_listeners_ready "$name"
  engine=$(instances_json | jq -r --arg name "$name" '.[] | select(.name == $name) | .engine')
  case "$engine" in
    mongodb) probe_mongodb_ready "$name" ;;
    mysql) probe_mysql_ready "$name" ;;
    manticore) probe_manticore_ready "$name" ;;
    *) echo "unsupported engine in runtime manifest: $engine" >&2; return 1 ;;
  esac
}

wait_instance_ready() {
  local name=$1 timeout=${2:-$DEFAULT_READY_TIMEOUT}
  [[ "$timeout" =~ ^[1-9][0-9]*$ ]] || die "invalid readiness timeout: $timeout"
  retry_probe "$name readiness" "$timeout" "$READY_RETRY_INTERVAL" instance_readiness_probe "$name" \
    || die "$name did not become ready"
}

wait_managed_ready() {
  local timeout=${1:-$DEFAULT_READY_TIMEOUT} name
  while IFS= read -r name; do
    wait_instance_ready "$name" "$timeout"
  done < <(service_names)
}

check_filesystems_and_quotas() {
  local data mount fstype options project limit expected actual
  data=$(instances_json)
  while read -r mount; do
    fstype=$(findmnt -n -o FSTYPE --target "$mount")
    options=$(findmnt -n -o OPTIONS --target "$mount")
    [[ "$fstype" == xfs ]] || die "$mount is not XFS"
    grep -Eq '(^|,)prjquota(,|$)' <<<"$options" || die "$mount is missing prjquota"
  done < <(jq -r '.[].mountPoint' <<<"$data" | sort -u)
  while IFS=$'\t' read -r mount project limit; do
    expected=$(size_kib "$limit")
    actual=$(xfs_quota -x -c 'report -p -b -N' "$mount" \
      | awk -v id="#$project" '$1 == id { print $4; exit }')
    [[ -n "$actual" ]] || die "XFS project $project is absent on $mount"
    [[ "$actual" == "$expected" ]] \
      || die "XFS project $project on $mount has hard quota $actual KiB, expected $expected KiB"
  done < <(jq -r '.[] | [.mountPoint, (.projectId|tostring), .diskLimit] | @tsv' <<<"$data")
  echo '  XFS/prjquota/hard limits: PASS'
}

check_resources() {
  local data slice expected actual service cpu high max swap quota allowed field
  data=$(instances_json)
  slice=$(manifest_json | jq -c .slice)
  for field in memoryHigh memoryMax memorySwapMax; do
    expected=$(size_bytes "$(jq -r --arg field "$field" '.[$field]' <<<"$slice")")
    case "$field" in
      memoryHigh) actual=$(systemctl show database.slice -p MemoryHigh --value) ;;
      memoryMax) actual=$(systemctl show database.slice -p MemoryMax --value) ;;
      memorySwapMax) actual=$(systemctl show database.slice -p MemorySwapMax --value) ;;
    esac
    [[ "$actual" == "$expected" ]] || die "database.slice $field differs from manifest"
  done
  quota=$(systemctl show database.slice -p CPUQuotaPerSecUSec --value)
  allowed=$(systemctl show database.slice -p AllowedCPUs --value)
  [[ "$quota" == infinity && -z "$allowed" ]] || die 'database.slice has a CPU quota or pinning'
  while IFS=$'\t' read -r service cpu high max swap; do
    [[ $(systemctl show "$service.service" -p CPUWeight --value) == "$cpu" ]] || die "$service CPUWeight differs from manifest"
    [[ $(systemctl show "$service.service" -p MemoryHigh --value) == "$(size_bytes "$high")" ]] || die "$service MemoryHigh differs from manifest"
    [[ $(systemctl show "$service.service" -p MemoryMax --value) == "$(size_bytes "$max")" ]] || die "$service MemoryMax differs from manifest"
    [[ $(systemctl show "$service.service" -p MemorySwapMax --value) == "$(size_bytes "$swap")" ]] || die "$service MemorySwapMax differs from manifest"
    quota=$(systemctl show "$service.service" -p CPUQuotaPerSecUSec --value)
    allowed=$(systemctl show "$service.service" -p AllowedCPUs --value)
    [[ "$quota" == infinity && -z "$allowed" ]] || die "$service has a CPU quota or pinning"
  done < <(jq -r '.[] | [.serviceName,(.cpuWeight|tostring),.memoryHigh,.memoryMax,.memorySwapMax] | @tsv' <<<"$data")
  echo '  cgroup resources: PASS'
}

check_mongodb_auth() {
  local row credential name host port
  while IFS= read -r row; do
    name=$(jq -r .name <<<"$row")
    retry_probe "$name MongoDB authentication" "$DEFAULT_READY_TIMEOUT" "$READY_RETRY_INTERVAL" \
      probe_mongodb_ready "$name" || die "$name authenticated ping failed"
    credential=$(credential_for "$name")
    host=$(probe_host "$(jq -r .address <<<"$credential")")
    port=$(jq -r .ports.main <<<"$credential")
    if mongosh --quiet --host "$host" --port "$port" \
      --eval 'db.getSiblingDB("admin").getUsers()' >/dev/null 2>&1; then
      die "$name accepted unauthenticated privileged access"
    fi
    echo "  $name auth/unauth: PASS"
  done < <(instances_json | jq -c '.[] | select(.engine == "mongodb")')
}

check_mysql_auth() {
  local row name
  while IFS= read -r row; do
    name=$(jq -r .name <<<"$row")
    retry_probe "$name MySQL authentication" "$DEFAULT_READY_TIMEOUT" "$READY_RETRY_INTERVAL" \
      probe_mysql_ready "$name" || die "$name authenticated query/version failed"
    echo "  $name auth/query: PASS"
  done < <(instances_json | jq -c '.[] | select(.engine == "mysql")')
}

check_manticore_auth() {
  local row credential name host sql_port http_port user password table result code unauth body
  health_tmp=$(mktemp -d /run/nixdb-health.XXXXXX)
  chmod 0700 "$health_tmp"
  while IFS= read -r row; do
    name=$(jq -r .name <<<"$row")
    credential=$(credential_for "$name")
    host=$(probe_host "$(jq -r .address <<<"$credential")")
    sql_port=$(jq -r .ports.sql <<<"$credential")
    http_port=$(jq -r .ports.http <<<"$credential")
    user=$(jq -r .username <<<"$credential")
    password=$(jq -r .password <<<"$credential")
    retry_probe "$name Manticore/Buddy readiness" "$DEFAULT_READY_TIMEOUT" "$READY_RETRY_INTERVAL" \
      probe_manticore_ready "$name" || die "$name Manticore readiness failed"
    table="nixdb_health_${name//-/_}_$$"
    result=$(MYSQL_PWD="$password" mysql --protocol=TCP --host="$host" --port="$sql_port" \
      --user="$user" --ssl-mode=DISABLED --batch --skip-column-names --execute="
        DROP TABLE IF EXISTS $table;
        CREATE TABLE $table(title text); INSERT INTO $table VALUES(1,'hello');
        SELECT id,title FROM $table; DROP TABLE $table;
      ")
    grep -Fq $'1\thello' <<<"$result" || die "$name RT table check failed"
    body="$health_tmp/$name-http.json"
    code=$(curl --silent --show-error --output "$body" --write-out '%{http_code}' \
      --user "$user:$password" --data-binary 'SHOW STATUS' "http://$host:$http_port/sql?mode=raw")
    if [[ "$code" != 200 ]] || ! grep -Fq uptime "$body"; then
      die "$name authenticated HTTP failed"
    fi
    unauth=$(curl --silent --output /dev/null --write-out '%{http_code}' \
      --data-binary 'SHOW STATUS' "http://$host:$http_port/sql?mode=raw")
    [[ "$unauth" == 401 ]] || die "$name unauthenticated HTTP was not rejected"
    if mysql --protocol=TCP --host="$host" --port="$sql_port" \
      --ssl-mode=DISABLED --execute='SHOW STATUS' >/dev/null 2>&1; then
      die "$name accepted unauthenticated SQL"
    fi
    journalctl -b -u "$name.service" --no-pager | grep -F '[BUDDY] started' >/dev/null \
      || die "$name Buddy start record missing"
    if journalctl -b -u "$name.service" --no-pager | grep -Ei 'Buddy disabled|no manticore-buddy' >/dev/null; then
      die "$name reports disabled/missing Buddy"
    fi
    echo "  $name auth/Buddy/RT/HTTP: PASS"
  done < <(instances_json | jq -c '.[] | select(.engine == "manticore")')
  rm -rf -- "$health_tmp"
  health_tmp=""
}

run_health() {
  manifest_json >/dev/null
  credentials_json >/dev/null
  echo 'nixdb health'
  wait_managed_ready "$DEFAULT_READY_TIMEOUT"
  echo '  service/listener/auth readiness: PASS'
  check_units_and_ports
  check_filesystems_and_quotas
  check_resources
  check_mongodb_auth
  check_mysql_auth
  check_manticore_auth
  echo 'nixdb health: PASS'
}

active_system_health() {
  local active_system
  active_system=$(readlink -f "$CURRENT_SYSTEM")
  if [[ ! -x "$active_system/sw/bin/nixdb" ]]; then
    echo "nixdb: active system has no nixdb CLI: $active_system" >&2
    return 1
  fi
  "$active_system/sw/bin/nixdb" health
}

cmd_restart() {
  [[ $# -eq 1 ]] || die "usage: nixdb restart <instance>"
  validate_instance "$1"
  echo "Restarting $1.service"
  systemctl restart "$1.service"
  wait_instance_ready "$1" "$DEFAULT_READY_TIMEOUT"
  echo "  $1 readiness: PASS"
  run_health
}

cmd_wait() {
  local timeout=$DEFAULT_READY_TIMEOUT target=""
  while (($#)); do
    case "$1" in
      --timeout)
        [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] \
          || die 'usage: nixdb wait [<instance>] [--timeout <seconds>]'
        timeout=$2
        shift
        ;;
      --*) die 'usage: nixdb wait [<instance>] [--timeout <seconds>]' ;;
      *)
        [[ -z "$target" ]] || die 'usage: nixdb wait [<instance>] [--timeout <seconds>]'
        target=$1
        ;;
    esac
    shift
  done
  credentials_json >/dev/null
  if [[ -n "$target" ]]; then
    validate_instance "$target"
    wait_instance_ready "$target" "$timeout"
    echo "nixdb wait: $target ready"
  else
    wait_managed_ready "$timeout"
    echo 'nixdb wait: all managed instances ready'
  fi
}

cmd_doctor() {
  local failures=0 manifest_ok=false mount fstype options
  echo 'nixdb doctor'
  if [[ -e /etc/NIXOS ]] && command -v systemctl >/dev/null 2>&1; then
    echo '  NixOS/systemd: PASS'
  else
    echo '  NixOS/systemd: FAIL'
    failures=$((failures + 1))
  fi
  if [[ -r "$MANIFEST" ]] \
    && jq -e '.schemaVersion == 1 and (.instances | type == "array")' "$MANIFEST" >/dev/null 2>&1; then
    echo '  runtime manifest schema: PASS'
    manifest_ok=true
  else
    echo "  runtime manifest schema: FAIL ($MANIFEST)"
    failures=$((failures + 1))
  fi
  if [[ "$manifest_ok" == true ]]; then
    while read -r mount; do
      if ! findmnt --target "$mount" >/dev/null 2>&1; then
        echo "  mount $mount: FAIL (not mounted)"
        failures=$((failures + 1))
        continue
      fi
      fstype=$(findmnt -n -o FSTYPE --target "$mount")
      options=$(findmnt -n -o OPTIONS --target "$mount")
      if [[ "$fstype" == xfs ]] && grep -Eq '(^|,)prjquota(,|$)' <<<"$options"; then
        echo "  mount $mount XFS/prjquota: PASS"
      else
        echo "  mount $mount XFS/prjquota: FAIL"
        failures=$((failures + 1))
      fi
    done < <(instances_json | jq -r '.[].mountPoint' | sort -u)
  fi
  if [[ -d "$CONFIG_ROOT" ]]; then
    echo "  config root $CONFIG_ROOT: PASS"
  else
    echo "  config root $CONFIG_ROOT: FAIL"
    failures=$((failures + 1))
  fi
  if [[ ! -e "$CONFIG_ROOT" ]]; then
    echo '  deployment metadata: config root does not exist'
  elif [[ ! -r "$CONFIG_ROOT" || ! -x "$CONFIG_ROOT" ]]; then
    echo '  deployment metadata: requires root (config root is not readable)'
  elif ! git -C "$CONFIG_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo '  deployment metadata: not a Git checkout'
  elif [[ ! -e "$CONFIG_ROOT/flake.lock" ]]; then
    echo '  deployment metadata: flake.lock is missing'
  elif [[ ! -r "$CONFIG_ROOT/flake.lock" ]]; then
    echo '  deployment metadata: requires root (flake.lock is not readable)'
  elif [[ -z $(lock_node_from "$CONFIG_ROOT/flake.lock") ]]; then
    echo "  deployment metadata: nixdb input '$INPUT_NAME' is missing"
  else
    echo '  deployment metadata: PASS'
  fi
  for command in jq systemctl findmnt xfs_quota nix nixos-rebuild git flock; do
    if ! command -v "$command" >/dev/null 2>&1; then
      echo "  required command $command: FAIL"
      failures=$((failures + 1))
    fi
  done
  ((failures == 0)) || die "$failures critical doctor checks failed"
  echo 'nixdb doctor: PASS'
}

resolve_plan_target() {
  local requested=${1:---latest}
  candidate_input_url=""
  case "$requested" in
    --latest)
      plan_ref=$(latest_stable_tag || true)
      [[ -n "$plan_ref" ]] || die 'no stable vMAJOR.MINOR.PATCH tags found'
      plan_label=$plan_ref
      ;;
    --main)
      plan_ref=main
      plan_label=main
      ;;
    --*) die "usage: nixdb plan [--latest|--main|<tag-or-revision>]" ;;
    *)
      validate_ref "$requested"
      plan_ref=$requested
      plan_label=$requested
      ;;
  esac
  candidate_input_url="${INPUT_URL}/${plan_ref}"
}

validate_input_url() {
  local value=$1
  [[ -n "$value" && ${#value} -le 4096 && "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
    || die 'candidate input URL must be a non-empty single-line flake reference'
}

resolve_direct_candidate() {
  local input_url=$1
  validate_input_url "$input_url"
  plan_ref=direct
  plan_label="direct input $input_url"
  candidate_input_url=$input_url
}

evaluate_candidate_manifest() {
  local candidate_root=$1 candidate_operator
  if ! candidate_manifest=$(nix eval --json \
    "$candidate_root#nixosConfigurations.${FLAKE_HOST}.config.services.nixdb._internal.runtimeManifest" \
    2>/dev/null); then
    candidate_operator=$(nix eval --raw \
      "$candidate_root#nixosConfigurations.${FLAKE_HOST}.config.environment.etc.\"nixdb/operator.json\".text")
    candidate_manifest=$(legacy_version_manifest <<<"$candidate_operator") \
      || die 'legacy candidate lacks complete DB version metadata'
  fi
  jq -e '(.schemaVersion == 0 or .schemaVersion == 1) and (.versions | type == "object")' \
    <<<"$candidate_manifest" >/dev/null \
    || die 'candidate produced unsupported DB version metadata'
}

prepare_candidate() {
  local target_ref=${1:-} candidate_root
  require_deployment_repo
  require_clean
  if [[ -n "$target_ref" && -z "$candidate_input_url" ]]; then
    validate_ref "$target_ref"
    plan_ref=$target_ref
    plan_label=$target_ref
    candidate_input_url="${INPUT_URL}/${target_ref}"
  fi
  [[ -n "$candidate_input_url" ]] || die 'candidate input URL was not resolved'
  work_tmp=$(mktemp -d "${TMPDIR:-/tmp}/nixdb-candidate.XXXXXX")
  chmod 0700 "$work_tmp"
  candidate_root="$work_tmp/host"
  mkdir -m 0700 "$candidate_root"
  git -C "$CONFIG_ROOT" archive --format=tar HEAD | tar -xf - -C "$candidate_root"
  [[ -f "$candidate_root/flake.lock" ]] || die 'tracked host source does not contain flake.lock'
  (
    cd "$candidate_root"
    nix flake lock --override-input "$INPUT_NAME" "$candidate_input_url"
  )
  evaluate_candidate_manifest "$candidate_root"
  candidate_lock="$candidate_root/flake.lock"
  candidate_input_metadata=$(input_metadata_json_from "$candidate_lock")
  candidate_revision=$(jq -r '.lockedRevision // "unavailable"' <<<"$candidate_input_metadata")
  current_manifest=$(active_version_manifest)
  current_input=$(input_metadata_json_from "$CONFIG_ROOT/flake.lock")
  db_upgrade_detected=false
  for engine in mongodb mysql manticore; do
    if [[ $(jq -r --arg engine "$engine" '.versions[$engine]' <<<"$current_manifest") \
      != $(jq -r --arg engine "$engine" '.versions[$engine]' <<<"$candidate_manifest") ]]; then
      db_upgrade_detected=true
    fi
  done
  if [[ $(jq -cS '.versions.manticoreComponents' <<<"$current_manifest") \
    != $(jq -cS '.versions.manticoreComponents' <<<"$candidate_manifest") ]]; then
    db_upgrade_detected=true
  fi
}

print_plan() {
  local engine label current target current_configured candidate_configured
  current_configured=$(jq -c .configuredInput <<<"$current_input" | configured_input_description)
  candidate_configured=$(jq -c .configuredInput <<<"$candidate_input_metadata" | configured_input_description)
  cat <<EOF
nixdb deployment plan
  current nixdb:  $(jq -r '.framework.version + " (" + .framework.revision + ")"' <<<"$current_manifest")
  target nixdb:   $(jq -r '.framework.version + " (" + .framework.revision + ")"' <<<"$candidate_manifest")
  target ref:     $plan_label
  target revision: $candidate_revision
  target release:  $(resolved_release_description "$candidate_input_metadata")

Database software versions
EOF
  for engine in mongodb mysql manticore; do
    case "$engine" in
      mongodb) label=MongoDB ;;
      mysql) label=MySQL ;;
      manticore) label=Manticore ;;
    esac
    current=$(jq -r --arg engine "$engine" '.versions[$engine]' <<<"$current_manifest")
    target=$(jq -r --arg engine "$engine" '.versions[$engine]' <<<"$candidate_manifest")
    printf '  %-10s current: %-20s target: %s\n' "$label" "$current" "$target"
  done
  echo "  Manticore component bundle changed: $(
    if [[ $(jq -cS '.versions.manticoreComponents' <<<"$current_manifest") \
      == $(jq -cS '.versions.manticoreComponents' <<<"$candidate_manifest") ]]; then echo no; else echo YES; fi
  )"
  echo
  echo "  DB upgrade detected:          $db_upgrade_detected"
  if [[ "$db_upgrade_detected" == true ]]; then
    echo '  Deployment allowed by default: no'
  else
    echo '  Deployment allowed by default: yes'
  fi
  echo "  Current configured input:   $current_configured"
  echo "  Current locked revision:    $(jq -r '.lockedRevision // "unavailable"' <<<"$current_input")"
  echo "  Current resolved release:   $(resolved_release_description "$current_input")"
  echo "  Candidate configured input: $candidate_configured"
  echo "  Candidate locked revision:  $candidate_revision"
  echo "  Candidate resolved release: $(resolved_release_description "$candidate_input_metadata")"
}

cmd_plan() {
  local requested=--latest direct_input=""
  while (($#)); do
    case "$1" in
      --latest|--main)
        [[ "$requested" == --latest ]] || die 'usage: nixdb plan [--latest|--main|<tag-or-revision>] [--input-url <flake-ref>]'
        requested=$1
        ;;
      --input-url)
        [[ $# -ge 2 && -z "$direct_input" ]] \
          || die 'usage: nixdb plan [--latest|--main|<tag-or-revision>] [--input-url <flake-ref>]'
        direct_input=$2
        shift
        ;;
      --*) die 'usage: nixdb plan [--latest|--main|<tag-or-revision>] [--input-url <flake-ref>]' ;;
      *)
        [[ "$requested" == --latest ]] || die 'usage: nixdb plan [--latest|--main|<tag-or-revision>] [--input-url <flake-ref>]'
        requested=$1
        ;;
    esac
    shift
  done
  if [[ -n "$direct_input" ]]; then
    [[ "$requested" == --latest ]] \
      || die 'a direct --input-url candidate cannot be combined with a ref'
    resolve_direct_candidate "$direct_input"
  else
    resolve_plan_target "$requested"
  fi
  prepare_candidate
  print_plan
}

print_upgrade_block() {
  local engine label
  cat >&2 <<'EOF'
Database software upgrade detected.
EOF
  for engine in mongodb mysql manticore; do
    case "$engine" in
      mongodb) label=MongoDB ;;
      mysql) label=MySQL ;;
      manticore) label=Manticore ;;
    esac
    cat >&2 <<EOF

$label:
  current:   $(jq -r --arg engine "$engine" '.versions[$engine]' <<<"$current_manifest")
  candidate: $(jq -r --arg engine "$engine" '.versions[$engine]' <<<"$candidate_manifest")
EOF
  done
  cat >&2 <<'EOF'

Deployment was NOT activated.

Review the upstream upgrade procedure and backup requirements. Verify backups
before allowing a DB software upgrade. Re-run with --allow-db-upgrade only
after explicitly accepting the migration.
EOF
}

enforce_db_upgrade_guard() {
  local allow_upgrade=$1
  if [[ "$db_upgrade_detected" == true && "$allow_upgrade" != true ]]; then
    print_upgrade_block
    return 2
  fi
}

current_generation() {
  nix-env --list-generations -p "$SYSTEM_PROFILE" \
    | awk '$NF == "(current)" { print $1; exit }'
}

db_versions_from_manifest() {
  jq -c '{mongodb:.versions.mongodb,mysql:.versions.mysql,manticore:.versions.manticore,
    manticoreComponents:.versions.manticoreComponents}' <<<"$1"
}

generation_marker() {
  echo "$STATE_DIR/generations/$(basename "$1").json"
}

record_generation_state() {
  local system_path=$1 host_revision=$2 manifest_data=$3 upgrade=$4 marker temp
  marker=$(generation_marker "$system_path")
  install -d -m 0700 "$STATE_DIR/generations"
  # A marker describes how this immutable system generation first entered
  # service. Do not erase a recorded DB-upgrade transition when that same
  # generation becomes the pre-deployment state of a later update.
  if [[ -r "$marker" ]]; then
    return
  fi
  temp=$(mktemp "$STATE_DIR/generations/.state.XXXXXX")
  jq -cn \
    --arg system "$system_path" \
    --arg hostRevision "$host_revision" \
    --arg frameworkVersion "$(jq -r .framework.version <<<"$manifest_data")" \
    --arg frameworkRevision "$(jq -r .framework.revision <<<"$manifest_data")" \
    --arg timestamp "$(date --iso-8601=seconds)" \
    --argjson dbVersions "$(db_versions_from_manifest "$manifest_data")" \
    --argjson dbUpgradeOccurred "$upgrade" \
    '{schemaVersion:1,system:$system,hostRevision:$hostRevision,
      framework:{version:$frameworkVersion,revision:$frameworkRevision},dbVersions:$dbVersions,
      timestamp:$timestamp,dbUpgradeOccurred:$dbUpgradeOccurred}' >"$temp"
  chmod 0600 "$temp"
  mv -f -- "$temp" "$marker"
}

write_deployment_state() {
  local system_path=$1 host_revision=$2 manifest_data=$3 upgrade=$4
  local previous_system=$5 previous_generation=$6 previous_revision=$7 temp input lock_revision lock_hash
  input=$(input_metadata_json_from "$CONFIG_ROOT/flake.lock")
  lock_revision=$(jq -r '.lockedRevision // empty' <<<"$input")
  lock_hash=$(sha256sum "$CONFIG_ROOT/flake.lock" | awk '{print $1}')
  install -d -m 0700 "$STATE_DIR"
  temp=$(mktemp "$STATE_DIR/.deployment-state.XXXXXX")
  jq -cn \
    --arg system "$system_path" \
    --arg generation "$(current_generation)" \
    --arg hostRevision "$host_revision" \
    --arg frameworkVersion "$(jq -r .framework.version <<<"$manifest_data")" \
    --arg frameworkRevision "$(jq -r .framework.revision <<<"$manifest_data")" \
    --arg lockRevision "$lock_revision" \
    --arg lockHash "$lock_hash" \
    --arg timestamp "$(date --iso-8601=seconds)" \
    --arg previousSystem "$previous_system" \
    --arg previousGeneration "$previous_generation" \
    --arg previousHostRevision "$previous_revision" \
    --argjson configuredInput "$(jq -c .configuredInput <<<"$input")" \
    --argjson resolvedRelease "$(jq -c .resolvedRelease <<<"$input")" \
    --arg resolvedReleaseState "$(jq -r .resolvedReleaseState <<<"$input")" \
    --argjson dbVersions "$(db_versions_from_manifest "$manifest_data")" \
    --argjson dbUpgradeOccurred "$upgrade" \
    '{schemaVersion:2,system:$system,generation:$generation,hostRevision:$hostRevision,
      framework:{version:$frameworkVersion,revision:$frameworkRevision,
        resolvedRelease:$resolvedRelease,resolvedReleaseState:$resolvedReleaseState},
      source:{configuredInput:$configuredInput,lockRevision:(if $lockRevision == "" then null else $lockRevision end),
        lockSha256:$lockHash},dbVersions:$dbVersions,
      timestamp:$timestamp,dbUpgradeOccurred:$dbUpgradeOccurred,
      previous:{system:$previousSystem,generation:$previousGeneration,hostRevision:$previousHostRevision}}' >"$temp"
  chmod 0600 "$temp"
  mv -f -- "$temp" "$STATE_DIR/deployment-state.json"
}

mapped_revision() {
  local marker legacy
  marker=$(generation_marker "$1")
  legacy="$STATE_DIR/generations/$(basename "$1")"
  if [[ -r "$marker" ]]; then
    jq -r '.hostRevision // "unknown"' "$marker"
  elif [[ -r "$legacy" ]]; then
    tr -d '\n' <"$legacy"
  else
    echo unknown
  fi
}

restore_source_checkout() {
  if [[ -n "$tx_old_branch" ]]; then
    git -C "$CONFIG_ROOT" switch --quiet "$tx_old_branch"
    git -C "$CONFIG_ROOT" reset --hard "$tx_old_commit"
  else
    git -C "$CONFIG_ROOT" switch --quiet --detach "$tx_old_commit"
    git -C "$CONFIG_ROOT" reset --hard "$tx_old_commit"
  fi
  install -m 0644 "$tx_lock_backup" "$CONFIG_ROOT/flake.lock"
  git -C "$CONFIG_ROOT" reset --quiet HEAD -- flake.lock
}

transaction_failure() {
  local rc=$1 runtime_status=not-needed source_status=failed health_status=not-run
  trap - ERR INT TERM
  set +e
  echo >&2
  echo "nixdb: FAILED at phase: $deployment_phase (exit $rc); starting recovery" >&2
  echo 'nixdb: restoring source checkout ...' >&2
  restore_source_checkout >&2
  if git -C "$CONFIG_ROOT" diff --quiet --exit-code \
    && [[ -z $(git -C "$CONFIG_ROOT" status --porcelain --untracked-files=all) ]]; then
    source_status=restored
  fi
  if ((tx_activation_started)); then
    runtime_status=failed
    echo "nixdb: restoring generation $tx_old_generation ..." >&2
    nix-env --switch-generation "$tx_old_generation" -p "$SYSTEM_PROFILE" >&2 \
      && "$tx_old_system/bin/switch-to-configuration" switch >&2 \
      && runtime_status=restored
  fi
  if [[ "$runtime_status" == restored || "$runtime_status" == not-needed ]]; then
    echo 'nixdb: recovery health ...' >&2
    if [[ -x "$tx_old_system/sw/bin/nixdb" ]] && "$tx_old_system/sw/bin/nixdb" health >&2; then
      health_status=PASS
    else
      health_status=FAILED
    fi
  fi
  echo "nixdb: final recovery state: source=$source_status runtime=$runtime_status health=$health_status" >&2
  if [[ "$source_status" != restored || "$runtime_status" == failed || "$health_status" == FAILED ]]; then
    echo 'nixdb: CRITICAL: automatic recovery was incomplete' >&2
  fi
  exit "$rc"
}

arm_transaction_traps() {
  trap 'transaction_failure $?' ERR
  trap 'transaction_failure 130' INT
  trap 'transaction_failure 143' TERM
}

disarm_transaction_traps() {
  trap - ERR INT TERM
}

deploy_candidate() {
  local allow_upgrade=$1 old_manifest old_input new_input new_system new_commit
  tx_activation_started=0
  deployment_phase='compare DB versions'
  enforce_db_upgrade_guard "$allow_upgrade"
  old_manifest=$(active_version_manifest)
  tx_old_commit=$(git -C "$CONFIG_ROOT" rev-parse --verify HEAD)
  tx_old_branch=$(git -C "$CONFIG_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  tx_old_system=$(readlink -f "$CURRENT_SYSTEM")
  tx_old_generation=$(current_generation)
  [[ -n "$tx_old_generation" ]] || die 'cannot determine current NixOS generation'
  old_input=$(locked_input_field_from "$CONFIG_ROOT/flake.lock" rev)
  new_input=$(locked_input_field_from "$candidate_lock" rev)
  tx_lock_backup="$work_tmp/flake.lock.before"
  install -m 0600 "$CONFIG_ROOT/flake.lock" "$tx_lock_backup"
  record_generation_state "$tx_old_system" "$tx_old_commit" "$old_manifest" false
  arm_transaction_traps

  cat <<EOF
nixdb deployment
  Host source:        $tx_old_commit
  nixdb input:        $old_input -> $new_input ($plan_label)
  System generation:  $tx_old_generation
  Current NixOS:      $tx_old_system
  DB upgrade allowed: $allow_upgrade
EOF

  echo '[1/8] Resolve candidate: PASS (private worktree)'
  echo '[2/8] Compare DB versions: PASS'
  deployment_phase='check flake'
  echo '[3/8] Check candidate flake'
  nix flake check "$work_tmp/host"
  deployment_phase='build candidate'
  echo '[4/8] Build candidate'
  nixos-rebuild build --flake "$work_tmp/host#$FLAKE_HOST"

  # This assignment is deliberately immediately before test activation. The
  # DB-version guard above must always run before this point.
  tx_activation_started=1
  deployment_phase='test candidate'
  echo '[5/8] Test candidate'
  nixos-rebuild test --flake "$work_tmp/host#$FLAKE_HOST"
  deployment_phase='validate test health'
  echo '[6/8] Validate test health'
  active_system_health
  deployment_phase='activate candidate'
  echo '[7/8] Activate candidate'
  nixos-rebuild switch --flake "$work_tmp/host#$FLAKE_HOST"
  deployment_phase='validate active health'
  echo '[8/8] Validate active health'
  active_system_health

  deployment_phase='commit downstream source'
  tx_lock_temp="$CONFIG_ROOT/.flake.lock.nixdb.$$"
  install -m 0644 "$candidate_lock" "$tx_lock_temp"
  mv -f -- "$tx_lock_temp" "$CONFIG_ROOT/flake.lock"
  tx_lock_temp=""
  new_system=$(readlink -f "$CURRENT_SYSTEM")
  if ! git -C "$CONFIG_ROOT" diff --quiet -- flake.lock; then
    git -C "$CONFIG_ROOT" add -- flake.lock
    git -C "$CONFIG_ROOT" commit -m "nixdb: deploy $plan_label"
  fi
  new_commit=$(git -C "$CONFIG_ROOT" rev-parse --verify HEAD)
  record_generation_state "$new_system" "$new_commit" "$candidate_manifest" "$db_upgrade_detected"
  deployment_phase='write deployment state'
  write_deployment_state "$new_system" "$new_commit" "$candidate_manifest" "$db_upgrade_detected" \
    "$tx_old_system" "$tx_old_generation" "$tx_old_commit"
  require_clean
  disarm_transaction_traps
  echo 'nixdb: deployment succeeded'
  echo "  Host source: $new_commit"
  echo "  nixdb input: $new_input ($plan_label)"
  echo "  System:      $new_system"
}

parse_update_args() {
  update_target=--latest
  allow_db_upgrade=false
  while (($#)); do
    case "$1" in
      --main) update_target=--main ;;
      --allow-db-upgrade) allow_db_upgrade=true ;;
      *) die 'usage: nixdb update [--main] [--allow-db-upgrade]' ;;
    esac
    shift
  done
}

cmd_update() {
  parse_update_args "$@"
  resolve_plan_target "$update_target"
  prepare_candidate "$plan_ref"
  print_plan
  deploy_candidate "$allow_db_upgrade"
}

cmd_deploy() {
  local requested="" allow_db_upgrade=false direct_input=""
  while (($#)); do
    case "$1" in
      --allow-db-upgrade) allow_db_upgrade=true ;;
      --input-url)
        [[ $# -ge 2 && -z "$direct_input" ]] \
          || die 'usage: nixdb deploy <tag-or-revision> [--allow-db-upgrade] | nixdb deploy --input-url <flake-ref> [--allow-db-upgrade]'
        direct_input=$2
        shift
        ;;
      --*) die 'usage: nixdb deploy <tag-or-revision> [--allow-db-upgrade] | nixdb deploy --input-url <flake-ref> [--allow-db-upgrade]' ;;
      *)
        [[ -z "$requested" ]] || die 'usage: nixdb deploy <tag-or-revision> [--allow-db-upgrade] | nixdb deploy --input-url <flake-ref> [--allow-db-upgrade]'
        requested=$1
        ;;
    esac
    shift
  done
  if [[ -n "$direct_input" ]]; then
    [[ -z "$requested" ]] || die 'a direct --input-url candidate cannot be combined with a ref'
    resolve_direct_candidate "$direct_input"
  else
    [[ -n "$requested" ]] || die 'usage: nixdb deploy <tag-or-revision> [--allow-db-upgrade] | nixdb deploy --input-url <flake-ref> [--allow-db-upgrade]'
    resolve_plan_target "$requested"
  fi
  prepare_candidate
  print_plan
  deploy_candidate "$allow_db_upgrade"
}

restore_rollback_failure() {
  local rc=$1 old_commit=$2 old_system=$3 old_generation=$4 old_branch=$5
  trap - ERR INT TERM
  set +e
  echo "nixdb: rollback failed; restoring generation $old_generation" >&2
  nix-env --switch-generation "$old_generation" -p "$SYSTEM_PROFILE" >&2
  "$old_system/bin/switch-to-configuration" switch >&2
  if [[ -n "$old_branch" ]]; then
    git -C "$CONFIG_ROOT" switch --quiet "$old_branch" >&2
    git -C "$CONFIG_ROOT" reset --hard "$old_commit" >&2
  else
    git -C "$CONFIG_ROOT" switch --quiet --detach "$old_commit" >&2
  fi
  if [[ -x "$old_system/sw/bin/nixdb" ]]; then
    "$old_system/sw/bin/nixdb" health >&2 \
      || echo 'nixdb: CRITICAL: restored generation health failed' >&2
  fi
  exit "$rc"
}

select_rollback_target() {
  local old_system=$1 old_generation=$2 state recorded_generation recorded_system profile_system
  state="$STATE_DIR/deployment-state.json"
  if [[ -r "$state" ]] \
    && jq -e --arg system "$old_system" '
      .schemaVersion == 1 and .system == $system
      and (.previous.generation | type == "string")
      and (.previous.system | type == "string")
    ' "$state" >/dev/null 2>&1; then
    recorded_generation=$(jq -r .previous.generation "$state")
    recorded_system=$(jq -r .previous.system "$state")
    profile_system=$(readlink -f "${SYSTEM_PROFILE}-${recorded_generation}-link" 2>/dev/null || true)
    if [[ -n "$profile_system" && "$profile_system" == "$recorded_system" ]]; then
      previous_generation=$recorded_generation
      previous_system=$recorded_system
      return
    fi
    warn 'recorded previous generation is unavailable or no longer matches its system path'
  fi

  previous_generation=$(nix-env --list-generations -p "$SYSTEM_PROFILE" \
    | awk -v current="$old_generation" '$1 < current { previous=$1 } END { print previous }')
  [[ -n "$previous_generation" ]] || die 'no previous NixOS generation is available'
  previous_system=$(readlink -f "${SYSTEM_PROFILE}-${previous_generation}-link")
}

cmd_rollback() {
  local allow_binary=false old_commit old_branch old_system old_generation previous_generation previous_system revision
  local current_marker target_marker risky=false
  [[ $# -le 1 ]] || die 'usage: nixdb rollback [--allow-db-binary-rollback]'
  if [[ $# -eq 1 ]]; then
    [[ "$1" == --allow-db-binary-rollback ]] \
      || die 'usage: nixdb rollback [--allow-db-binary-rollback]'
    allow_binary=true
  fi
  require_deployment_repo
  require_clean
  old_commit=$(git -C "$CONFIG_ROOT" rev-parse --verify HEAD)
  old_branch=$(git -C "$CONFIG_ROOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  old_system=$(readlink -f "$CURRENT_SYSTEM")
  old_generation=$(current_generation)
  select_rollback_target "$old_system" "$old_generation"
  current_marker=$(generation_marker "$old_system")
  target_marker=$(generation_marker "$previous_system")
  if [[ -r "$current_marker" ]] && jq -e '.dbUpgradeOccurred == true' "$current_marker" >/dev/null; then
    risky=true
  fi
  if [[ -r "$current_marker" && -r "$target_marker" ]] \
    && [[ $(jq -cS .dbVersions "$current_marker") != $(jq -cS .dbVersions "$target_marker") ]]; then
    risky=true
  fi
  cat <<EOF
nixdb rollback
  Current generation:  $old_generation ($old_system)
  Target generation:   $previous_generation ($previous_system)

This rolls back NixOS/system configuration. It does NOT roll back database
contents or database file formats.
EOF
  if [[ "$risky" == true ]]; then
    cat >&2 <<'EOF'

WARNING: recorded database software versions differ across this rollback.
Starting an older database binary after a data-format migration may be unsafe.
EOF
    [[ "$allow_binary" == true ]] \
      || die 'rollback blocked; review upstream downgrade safety, then use --allow-db-binary-rollback'
  elif [[ ! -r "$current_marker" || ! -r "$target_marker" ]]; then
    warn 'generation DB-version metadata is incomplete; binary downgrade safety cannot be proven'
  fi
  trap 'restore_rollback_failure $? "$old_commit" "$old_system" "$old_generation" "$old_branch"' ERR
  trap 'restore_rollback_failure 130 "$old_commit" "$old_system" "$old_generation" "$old_branch"' INT
  trap 'restore_rollback_failure 143 "$old_commit" "$old_system" "$old_generation" "$old_branch"' TERM
  nix-env --switch-generation "$previous_generation" -p "$SYSTEM_PROFILE"
  "$previous_system/bin/switch-to-configuration" switch
  revision=$(mapped_revision "$(readlink -f "$CURRENT_SYSTEM")")
  if [[ "$revision" =~ ^[0-9a-f]{40}$ ]] \
    && git -C "$CONFIG_ROOT" cat-file -e "${revision}^{commit}" 2>/dev/null; then
    git -C "$CONFIG_ROOT" switch --detach "$revision"
  else
    warn "source mapping unavailable; leaving checkout at $old_commit"
  fi
  active_system_health
  trap - ERR INT TERM
  echo 'nixdb: rollback succeeded'
  echo "  Active generation: $(current_generation)"
  echo "  Source revision:   $(git -C "$CONFIG_ROOT" rev-parse --verify HEAD)"
}

validate_config_root() {
  [[ "$1" == /* && "$1" != *$'\n'* && "$1" != *$'\r'* ]] \
    || die '--config-root must be an absolute single-line path'
}

validate_flake_host() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] \
    || die '--flake-host contains unsupported characters'
}

validate_input_name() {
  [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] \
    || die '--input-name contains unsupported characters'
}

parse_global_context() {
  CLI_REMAINING=("$@")
  while ((${#CLI_REMAINING[@]})); do
    case "${CLI_REMAINING[0]}" in
      --config-root)
        ((${#CLI_REMAINING[@]} >= 2)) || die 'usage: nixdb --config-root <path> <command>'
        validate_config_root "${CLI_REMAINING[1]}"
        CONFIG_ROOT=${CLI_REMAINING[1]}
        CLI_REMAINING=("${CLI_REMAINING[@]:2}")
        ;;
      --flake-host)
        ((${#CLI_REMAINING[@]} >= 2)) || die 'usage: nixdb --flake-host <host> <command>'
        validate_flake_host "${CLI_REMAINING[1]}"
        FLAKE_HOST=${CLI_REMAINING[1]}
        CLI_REMAINING=("${CLI_REMAINING[@]:2}")
        ;;
      --input-name)
        ((${#CLI_REMAINING[@]} >= 2)) || die 'usage: nixdb --input-name <name> <command>'
        validate_input_name "${CLI_REMAINING[1]}"
        INPUT_NAME=${CLI_REMAINING[1]}
        CLI_REMAINING=("${CLI_REMAINING[@]:2}")
        ;;
      *) break ;;
    esac
  done
}

plan_requires_root() {
  is_root && return 1
  if [[ ! -d "$CONFIG_ROOT" || ! -r "$CONFIG_ROOT" || ! -x "$CONFIG_ROOT" ]]; then
    return 0
  fi
  if git -C "$CONFIG_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    [[ -e "$CONFIG_ROOT/flake.lock" && ! -r "$CONFIG_ROOT/flake.lock" ]] && return 0
    return 1
  fi
  # An inaccessible .git is the common case for a root-owned NixOS checkout.
  # If no Git metadata exists at all, keep the useful non-Git diagnostic and
  # do not ask for sudo merely to report it.
  [[ -e "$CONFIG_ROOT/.git" ]]
}

maybe_elevate_plan() {
  if plan_requires_root; then
    need_root "$@"
  fi
}

main() {
  local -a original_args=("$@")
  local command
  parse_global_context "$@"
  command=${CLI_REMAINING[0]:-help}
  if [[ "$command" == help || "$command" == --help || "$command" == -h ]]; then
    show_help
    return
  fi
  CLI_REMAINING=("${CLI_REMAINING[@]:1}")
  case "$command" in
    health|quotas|logs|restart|wait|update|deploy|rollback)
      need_root "${original_args[@]}"
      ;;
    plan) maybe_elevate_plan "${original_args[@]}" ;;
  esac
  case "$command" in
    status) [[ ${#CLI_REMAINING[@]} -le 1 ]] || die 'usage: nixdb status [--json]'; cmd_status "${CLI_REMAINING[@]}" ;;
    health) [[ ${#CLI_REMAINING[@]} -eq 0 ]] || die 'usage: nixdb health'; run_health ;;
    wait) cmd_wait "${CLI_REMAINING[@]}" ;;
    doctor) [[ ${#CLI_REMAINING[@]} -eq 0 ]] || die 'usage: nixdb doctor'; cmd_doctor ;;
    versions) [[ ${#CLI_REMAINING[@]} -le 1 ]] || die 'usage: nixdb versions [--json]'; cmd_versions "${CLI_REMAINING[@]}" ;;
    quotas) [[ ${#CLI_REMAINING[@]} -eq 0 ]] || die 'usage: nixdb quotas'; cmd_quotas ;;
    resources) [[ ${#CLI_REMAINING[@]} -eq 0 ]] || die 'usage: nixdb resources'; cmd_resources ;;
    config) [[ ${#CLI_REMAINING[@]} -eq 0 ]] || die 'usage: nixdb config'; cmd_config ;;
    logs) cmd_logs "${CLI_REMAINING[@]}" ;;
    restart) cmd_restart "${CLI_REMAINING[@]}" ;;
    plan) cmd_plan "${CLI_REMAINING[@]}" ;;
    update) acquire_deployment_lock; cmd_update "${CLI_REMAINING[@]}" ;;
    deploy) acquire_deployment_lock; cmd_deploy "${CLI_REMAINING[@]}" ;;
    rollback) acquire_deployment_lock; cmd_rollback "${CLI_REMAINING[@]}" ;;
    *) die "unknown command: $command (run 'nixdb help')" ;;
  esac
}

if [[ ${NIXDB_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
